            float physics:dynamicFriction = 0.3
            float physics:restitution = 0
            float physics:staticFriction = 0.35
        }

        def Material "alu_75777c_38_100"
        {
            token outputs:surface.connect = </LightingTrack/Looks/alu_75777c_38_100/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.46, 0.47, 0.49)
                float inputs:metallic = 0.75
                float inputs:opacity = 1
                float inputs:roughness = 0.38
