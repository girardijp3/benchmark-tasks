#usda 1.0
(
    defaultPrim = "LightingTrack"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "LightingTrack" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    doc = "A 1.000 m Halo L651P single-circuit H-track, 35 x 17.5 mm, 24 mm slot, 120 V 20 A, slot DOWN on a bench pedestal at 0.9975 m.  Fixed.  Local origin at the track cross-section centre; table -0.250 m."
)
{
    point3f physics:centerOfMass = (0, 0, -0.12)
    float3 physics:diagonalInertia = (0.32, 0.6, 0.9)
    float physics:mass = 3.2

