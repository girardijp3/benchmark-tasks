#usda 1.0
(
    defaultPrim = "Handle"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Handle" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    doc = "A medium C-cell fibre-optic laryngoscope handle (Welch Allyn 60813 class): 28 mm x 150 mm grip, 0.25 kg, with the head bridge and the 4.5 mm hinge bar. Origin: middle of the grip; y along it (+y the base end); z up."
)
{
    point3f physics:centerOfMass = (0.004, 0, 0)
    float3 physics:diagonalInertia = (0.000481, 0.0000245, 0.000481)
    float physics:mass = 0.25

    def Scope "Looks"
    {
        def Material "Phys_handle" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.25
            float physics:restitution = 0
            float physics:staticFriction = 0.3
        }

        def Material "Phys_head" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.25
            float physics:restitution = 0
            float physics:staticFriction = 0.3
        }

        def Material "P_chrome"
        {
            token outputs:surface.connect = </Handle/Looks/P_chrome/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.82, 0.86)
                float inputs:metallic = 0.75
                float inputs:roughness = 0.28
                token outputs:surface
            }
        }

        def Material "P_dark"
        {
            token outputs:surface.connect = </Handle/Looks/P_dark/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.11, 0.13)
                float inputs:metallic = 0.3
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "P_green"
        {
            token outputs:surface.connect = </Handle/Looks/P_green/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.08, 0.5, 0.22)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "P_smoke"
        {
            token outputs:surface.connect = </Handle/Looks/P_smoke/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.45, 0.52, 0.6)
                float inputs:metallic = 0.2
                float inputs:opacity = 0.35
                float inputs:roughness = 0.2
                token outputs:surface
            }
        }
    }

    def Cylinder "Grip1" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        uniform token axis = "Y"
        double height = 0.15
        rel material:binding:physics = </Handle/Looks/Phys_handle> (
            bindMaterialAs = "weakerThanDescendants"
        )
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        uniform token purpose = "guide"
        double radius = 0.014
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cube "Bridge2" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </Handle/Looks/Phys_head> (
            bindMaterialAs = "weakerThanDescendants"
        )
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        uniform token purpose = "guide"
        double size = 1
        float3 xformOp:scale = (0.038, 0.026, 0.006)
        double3 xformOp:translate = (0.017, -0.087, 0.01)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Head3" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </Handle/Looks/Phys_head> (
            bindMaterialAs = "weakerThanDescendants"
        )
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        uniform token purpose = "guide"
        double size = 1
        float3 xformOp:scale = (0.028, 0.012, 0.028)
        double3 xformOp:translate = (0, -0.081, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cylinder "Bar4" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
