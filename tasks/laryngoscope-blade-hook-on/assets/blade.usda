#usda 1.0
(
    defaultPrim = "Blade"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Blade" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsArticulationRootAPI"]
    doc = "A Macintosh 3 style fibre-optic laryngoscope blade (ISO 7376 hook-on), 130 mm, 0.08 kg, with a flared hook slot in the base face and a visual lamp marker at the tip. Origin: middle of the base face, half-way up; +x toward the tip."
)
{
    point3f physics:centerOfMass = (0.055, 0, 0)
    float3 physics:diagonalInertia = (0.0000053333333, 0.000115333336, 0.000115333336)
    float physics:mass = 0.0799

    def Scope "Looks"
    {
        def Material "Phys_blade" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.3
            float physics:restitution = 0
            float physics:staticFriction = 0.35
        }

        def Material "P_steel"
        {
            token outputs:surface.connect = </Blade/Looks/P_steel/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.74, 0.76, 0.8)
                float inputs:metallic = 0.7
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "P_bdark"
        {
            token outputs:surface.connect = </Blade/Looks/P_bdark/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.06, 0.06, 0.07)
                float inputs:metallic = 0.2
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "P_bgreen"
        {
            token outputs:surface.connect = </Blade/Looks/P_bgreen/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.08, 0.5, 0.22)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "P_lamp"
        {
            token outputs:surface.connect = </Blade/Looks/P_lamp/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 0.92, 0.35)
                color3f inputs:emissiveColor = (1, 0.85, 0.2)
                float inputs:metallic = 0
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }
    }

    def Mesh "Hook1" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI", "MaterialBindingAPI"]
    )
    {
        float3[] extent = [(0, 0.0025, -0.01), (0.0065, 0.0125, 0.01)]
        int[] faceVertexCounts = [3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3]
