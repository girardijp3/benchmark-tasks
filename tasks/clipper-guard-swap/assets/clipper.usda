#usda 1.0
(
    defaultPrim = "Clipper"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Clipper" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    doc = "Hand clipper lying on its flat back, 160 mm overall (housing 93 mm, blade collar 22 mm, blade head 45 mm), 280 g. Origin on the table at the blade collar's front face on the centre line, +x toward the blade tip. A catch ridge on the collar's top holds the guard's rear clip."
)
{
    point3f physics:centerOfMass = (-0.05357235, 0, 0.015779816)
    float3 physics:diagonalInertia = (0.00007196638, 0.00046707434, 0.00048502506)
    float physics:mass = 0.28
    quatf physics:principalAxes = (0, 0.045548033, 0, 0.99896216)

    def Scope "Looks"
    {
        def Material "Phys_ABS" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.35
            float physics:restitution = 0
            float physics:staticFriction = 0.4
        }

        def Material "Phys_Steel" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.3
            float physics:restitution = 0
            float physics:staticFriction = 0.35
        }

        def Material "Housing"
        {
            token outputs:surface.connect = </Clipper/Looks/Housing/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.12, 0.16)
                float inputs:metallic = 0
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "HousingTrim"
        {
            token outputs:surface.connect = </Clipper/Looks/HousingTrim/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.57, 0.6)
                float inputs:metallic = 0.8
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "Switch"
        {
            token outputs:surface.connect = </Clipper/Looks/Switch/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.12, 0.1)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "Steel"
        {
            token outputs:surface.connect = </Clipper/Looks/Steel/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.74, 0.76, 0.79)
                float inputs:metallic = 1
                float inputs:roughness = 0.25
                token outputs:surface
            }
        }

        def Material "BladeDark"
        {
            token outputs:surface.connect = </Clipper/Looks/BladeDark/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.25, 0.26, 0.28)
                float inputs:metallic = 1
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }
    }

    def Scope "Colliders"
    {
        def Cube "Housing" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </Clipper/Looks/Phys_ABS> (
                bindMaterialAs = "weakerThanDescendants"
            )
            custom float physxCollision:contactOffset = 0.0005
            custom float physxCollision:restOffset = 0
            uniform token purpose = "guide"
            double size = 1
            float3 xformOp:scale = (0.093, 0.042, 0.036)
            double3 xformOp:translate = (-0.0685, 0, 0.018000000000000002)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
