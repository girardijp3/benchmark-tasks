#usda 1.0
(
    defaultPrim = "Guard"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Guard" (
    doc = "Guide comb no. 2 (2/8 in = 6.4 mm cutting length), 54 x 53 mm, roof 19.4 mm high, with a rear clip: a sprung arm on a hinge whose hook rides over the clipper's catch ridge and drops behind it. Origin on the table at the comb's rear edge on the centre line, +x toward the teeth. Joint Clip: 0 with the hook down, positive lifts the hook."
)
{
    def Scope "Looks"
    {
        def Material "Phys_ABS" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.35
            float physics:restitution = 0
            float physics:staticFriction = 0.4
        }

        def Material "Comb"
        {
            token outputs:surface.connect = </Guard/Looks/Comb/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.05, 0.05, 0.06)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "Digit"
        {
            token outputs:surface.connect = </Guard/Looks/Digit/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.95, 0.92)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "Clip"
        {
            token outputs:surface.connect = </Guard/Looks/Clip/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.92, 0.45, 0.08)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
    }

