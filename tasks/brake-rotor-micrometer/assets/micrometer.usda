#usda 1.0
(
    defaultPrim = "Micrometer"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Micrometer" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsArticulationRootAPI"]
    doc = "A 0-25 mm outside micrometer with ratchet stop and lock lever (Mitutoyo 103-137 class: 175 g, 18 mm thimble, 6.35 mm carbide faces, 0.5 mm pitch; frame dimensions typical). A free articulation: the frame is the root; the spindle slides along y (prismatic, drive-limited to the 10 N measuring force), the thimble and the ratchet knob turn about y, the lock lever turns about x. Origin: the anvil face's centre; the anvil is at +y, the thimble toward -y, the throat opens toward +x."
)
{
    point3f physics:centerOfMass = (-0.015, -0.011, 0)
    float3 physics:diagonalInertia = (0.000025999334, 0.000025999334, 0.000049166665)
    float physics:mass = 0.118

