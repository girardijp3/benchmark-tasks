#usda 1.0
(
    defaultPrim = "CaliperBracket"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "CaliperBracket" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    doc = "Fixed painted-steel caliper carrier (bracket) still bolted to the steering knuckle at the bottom of the installed rotor; the caliper and pads are removed for the inspection so both friction faces are open. Origin: the rotor's hub centre (same as rotor.usda). The bridge straddles the disc rim at 6 o'clock; the two abutment rails and mounting ears are representative of a 2001-05 VW Golf IV front caliper (estimates)."
)
{
    point3f physics:centerOfMass = (0, -0.01, -0.14)
    float3 physics:diagonalInertia = (0.02, 0.02, 0.01)
    float physics:mass = 2.4

    def Scope "Looks"
    {
        def Material "Phys_iron" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.5
            float physics:restitution = 0
            float physics:staticFriction = 0.45
        }

        def Material "m252730"
        {
            token outputs:surface.connect = </CaliperBracket/Looks/m252730/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.26, 0.28, 0.31)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }
    }

    def Cube "Bridge1" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </CaliperBracket/Looks/m252730>
        rel material:binding:physics = </CaliperBracket/Looks/Phys_iron> (
            bindMaterialAs = "weakerThanDescendants"
        )
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.11, 0.0515, 0.016)
        double3 xformOp:translate = (0, 0, -0.152)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "MountEar2" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </CaliperBracket/Looks/m252730>
        rel material:binding:physics = </CaliperBracket/Looks/Phys_iron> (
            bindMaterialAs = "weakerThanDescendants"
        )
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.024, 0.06175, 0.03)
        double3 xformOp:translate = (-0.05, -0.014875, -0.15)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cylinder "BracketBoltHole3" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        uniform token axis = "Y"
        double height = 0.024
        rel material:binding:physics = </CaliperBracket/Looks/Phys_iron> (
            bindMaterialAs = "weakerThanDescendants"
        )
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        uniform token purpose = "guide"
        double radius = 0.006
        double3 xformOp:translate = (-0.05, -0.04675, -0.15)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cube "MountEar4" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </CaliperBracket/Looks/m252730>
        rel material:binding:physics = </CaliperBracket/Looks/Phys_iron> (
            bindMaterialAs = "weakerThanDescendants"
        )
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.024, 0.06175, 0.03)
        double3 xformOp:translate = (0.05, -0.014875, -0.15)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cylinder "BracketBoltHole5" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        uniform token axis = "Y"
        double height = 0.024
        rel material:binding:physics = </CaliperBracket/Looks/Phys_iron> (
            bindMaterialAs = "weakerThanDescendants"
        )
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        uniform token purpose = "guide"
        double radius = 0.006
        double3 xformOp:translate = (0.05, -0.04675, -0.15)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cube "AbutmentRail6" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </CaliperBracket/Looks/m252730>
        rel material:binding:physics = </CaliperBracket/Looks/Phys_iron> (
            bindMaterialAs = "weakerThanDescendants"
        )
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.09, 0.008, 0.022)
        double3 xformOp:translate = (0, -0.01575, -0.131)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "AbutmentRail7" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </CaliperBracket/Looks/m252730>
        rel material:binding:physics = </CaliperBracket/Looks/Phys_iron> (
            bindMaterialAs = "weakerThanDescendants"
        )
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.09, 0.008, 0.022)
        double3 xformOp:translate = (0, 0.01575, -0.131)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}

