#usda 1.0
(
    defaultPrim = "ROOT"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "ROOT" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    doc = "A robot arm link in a repair jig: a 25 mm carbon-fibre tube 300 mm long with an aluminium joint housing at each end, held in two saddles; a 30 mm band is painted at the clip's place. Fixed to the table."
)
{
    bool physics:kinematicEnabled = true
    float physics:mass = 2.0

    def Scope "Looks"
    {
        def Material "Carbon"
        {
            token outputs:surface.connect = </ROOT/Looks/Carbon/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.1, 0.11)
                float inputs:metallic = 0.1
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }
        def Material "Alu"
        {
            token outputs:surface.connect = </ROOT/Looks/Alu/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.72, 0.74, 0.77)
                float inputs:metallic = 0.8
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }
        def Material "Band"
        {
            token outputs:surface.connect = </ROOT/Looks/Band/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.85, 0.1)
                float inputs:metallic = 0
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }
        def Material "Jig"
        {
            token outputs:surface.connect = </ROOT/Looks/Jig/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.2, 0.3, 0.55)
                float inputs:metallic = 0
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }
        def Material "Phys_Carbon" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.25
            float physics:restitution = 0
            float physics:staticFriction = 0.3
        }
    }

    def Cylinder "Tube" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </ROOT/Looks/Carbon>
        uniform token axis = "Z"
        double height = 0.3
        double radius = 0.0125
        double3 xformOp:translate = (0, 0, 0.06)
        float3 xformOp:rotateXYZ = (-90, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
    def Cylinder "HousingA" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </ROOT/Looks/Alu>
        uniform token axis = "Z"
        double height = 0.04
        double radius = 0.026
        double3 xformOp:translate = (0, 0.17, 0.06)
        float3 xformOp:rotateXYZ = (-90, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
    def Cube "SaddleA" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </ROOT/Looks/Jig>
        double size = 1
        double3 xformOp:translate = (0, 0.17, 0.0209)
        float3 xformOp:scale = (0.05, 0.04, 0.0418)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cylinder "HousingB" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </ROOT/Looks/Alu>
        uniform token axis = "Z"
        double height = 0.04
        double radius = 0.026
        double3 xformOp:translate = (0, -0.17, 0.06)
        float3 xformOp:rotateXYZ = (-90, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
    def Cube "SaddleB" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </ROOT/Looks/Jig>
        double size = 1
        double3 xformOp:translate = (0, -0.17, 0.0209)
        float3 xformOp:scale = (0.05, 0.04, 0.0418)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cylinder "PaintedBand" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </ROOT/Looks/Band>
        uniform token axis = "Z"
        double height = 0.03
        double radius = 0.0129
        double3 xformOp:translate = (0, 0, 0.06)
        float3 xformOp:rotateXYZ = (-90, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    def Scope "Colliders"
    {
        def Cylinder "Tube" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </ROOT/Looks/Phys_Carbon> (
                bindMaterialAs = "weakerThanDescendants"
            )
            custom float physxCollision:contactOffset = 0.002
            custom float physxCollision:restOffset = 0
            uniform token purpose = "guide"
            uniform token axis = "Z"
            double height = 0.3
            double radius = 0.0125
        double3 xformOp:translate = (0, 0, 0.06)
        float3 xformOp:rotateXYZ = (-90, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
        }
        def Cylinder "HousingA" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </ROOT/Looks/Phys_Carbon> (
                bindMaterialAs = "weakerThanDescendants"
            )
            custom float physxCollision:contactOffset = 0.002
            custom float physxCollision:restOffset = 0
            uniform token purpose = "guide"
            uniform token axis = "Z"
            double height = 0.04
            double radius = 0.026
        double3 xformOp:translate = (0, 0.17, 0.06)
        float3 xformOp:rotateXYZ = (-90, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
        }
        def Cube "SaddleA" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </ROOT/Looks/Phys_Carbon> (
                bindMaterialAs = "weakerThanDescendants"
            )
            custom float physxCollision:contactOffset = 0.002
            custom float physxCollision:restOffset = 0
            uniform token purpose = "guide"
            double size = 1
        double3 xformOp:translate = (0, 0.17, 0.0209)
        float3 xformOp:scale = (0.05, 0.04, 0.0418)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cylinder "HousingB" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </ROOT/Looks/Phys_Carbon> (
                bindMaterialAs = "weakerThanDescendants"
            )
            custom float physxCollision:contactOffset = 0.002
            custom float physxCollision:restOffset = 0
            uniform token purpose = "guide"
            uniform token axis = "Z"
            double height = 0.04
            double radius = 0.026
        double3 xformOp:translate = (0, -0.17, 0.06)
        float3 xformOp:rotateXYZ = (-90, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
        }
        def Cube "SaddleB" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </ROOT/Looks/Phys_Carbon> (
                bindMaterialAs = "weakerThanDescendants"
            )
            custom float physxCollision:contactOffset = 0.002
            custom float physxCollision:restOffset = 0
            uniform token purpose = "guide"
            double size = 1
        double3 xformOp:translate = (0, -0.17, 0.0209)
        float3 xformOp:scale = (0.05, 0.04, 0.0418)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }
}
