    def Scope "Joints"
    {
        def PhysicsRevoluteJoint "HingeR" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
            doc = "The right jaw's hinge: 0 is rest (lip 0.8 mm inside the tube); it opens by turning negative, against a 0.1 N m/rad spring."
        )
        {
            float drive:angular:physics:damping = 2.617994e-05
            float drive:angular:physics:stiffness = 0.001745329
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            uniform token physics:axis = "Y"
            rel physics:body0 = </ClipAsm/Clip>
            rel physics:body1 = </ClipAsm/JawR>
            point3f physics:localPos0 = (0.0147275, 0, 0.006867547)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -25
            float physics:upperLimit = 0
        }
        def PhysicsRevoluteJoint "HingeL" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
            doc = "The left jaw's hinge: 0 is rest; it opens by turning positive, against a 0.1 N m/rad spring."
        )
        {
            float drive:angular:physics:damping = 2.617994e-05
            float drive:angular:physics:stiffness = 0.001745329
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            uniform token physics:axis = "Y"
            rel physics:body0 = </ClipAsm/Clip>
            rel physics:body1 = </ClipAsm/JawL>
            point3f physics:localPos0 = (-0.0147275, 0, 0.006867547)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
