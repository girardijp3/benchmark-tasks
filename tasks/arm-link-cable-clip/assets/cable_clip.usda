#usda 1.0
(
    defaultPrim = "ClipAsm"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "ClipAsm" (
    doc = "Nylon cable clip for a 25 mm tube: a 24 mm wide ring with two spring jaws and a cable-tie loop on top."
)
{
    def Scope "Looks"
    {
        def Material "Plastic"
        {
            token outputs:surface.connect = </ClipAsm/Looks/Plastic/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.45, 0.1)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
        def Material "JawPlastic"
        {
            token outputs:surface.connect = </ClipAsm/Looks/JawPlastic/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.62, 0.1)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
        def Material "Slot"
        {
            token outputs:surface.connect = </ClipAsm/Looks/Slot/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.05, 0.05, 0.05)
                float inputs:metallic = 0
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }
        def Material "Phys_Plastic" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.25
            float physics:restitution = 0
            float physics:staticFriction = 0.3
        }
    }

    def Xform "Clip" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI", "PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
        doc = "The clip's ring and cable-tie loop: orange nylon, 24 mm wide, 38 mm across. Root link."
    )
    {
        float physics:mass = 0.024
        point3f physics:centerOfMass = (0, 0, 0.004)
        custom float physxRigidBody:maxDepenetrationVelocity = 0.2
        custom int physxRigidBody:solverPositionIterationCount = 32
        custom int physxRigidBody:solverVelocityIterationCount = 4
        custom bool physxArticulation:enabledSelfCollisions = 0
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

    def Cube "Ring0" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
