#usda 1.0
(
    defaultPrim = "Syringe"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Syringe" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    doc = "10 mL luer-lock syringe: 20 mm barrel, threaded collar, 6% male luer tip"
)
{
    point3f physics:centerOfMass = (0, 0, 0)
    float3 physics:diagonalInertia = (0.000001, 0.000001, 0.000001)
    float physics:mass = 0.012
    custom bool physxRigidBody:disableGravity = 1

    def Scope "Looks"
    {
        def Material "m778589_03"
        {
            token outputs:surface.connect = </Syringe/Looks/m778589_03/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.78, 0.86, 0.9)
                float inputs:metallic = 0
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

