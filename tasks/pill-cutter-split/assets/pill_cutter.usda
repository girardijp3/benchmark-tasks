#usda 1.0
(
    defaultPrim = "PillCutter"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "PillCutter" (
    doc = "A typical pill splitter, 80 x 40 mm, 11 mm tall base with a 20 mm wide V cradle along y (5.5 mm deep) and a hinged lid (80 x 40 mm, 12 mm clearance, a blade over the cradle's middle, a 24 mm tall, 6 mm thick pull fin standing on its top near the free edge). The hinge (axis along y, at the rim, on the robot's side) turns 0 shut to -95 deg open with 0.6 N m s/rad of friction. Origin on the table at the base's middle."
)
{
    def Scope "Looks"
    {
        def Material "Phys_abs" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.4
            float physics:restitution = 0
            float physics:staticFriction = 0.5
        }

        def Material "m929289"
        {
            token outputs:surface.connect = </PillCutter/Looks/m929289/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.93, 0.93, 0.9)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "m595959"
        {
            token outputs:surface.connect = </PillCutter/Looks/m595959/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
