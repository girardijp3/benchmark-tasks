    def PhysicsRevoluteJoint "Hinge" (
        prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        doc = "Lid hinge: 0 shut (lid away from the robot), negative opens up and back toward the robot, stop at -95 deg."
    )
    {
        float drive:angular:physics:damping = 0.010471975
        float drive:angular:physics:stiffness = 0.34906584
        float drive:angular:physics:targetPosition = 0
        uniform token drive:angular:physics:type = "force"
        uniform token physics:axis = "Y"
        rel physics:body0 = </PillCutter/Base>
        rel physics:body1 = </PillCutter/Lid>
        point3f physics:localPos0 = (-0.04, 0, 0.011)
        point3f physics:localPos1 = (0, 0, 0)
        quatf physics:localRot0 = (1, 0, 0, 0)
        quatf physics:localRot1 = (1, 0, 0, 0)
        float physics:lowerLimit = -95
        float physics:upperLimit = 1
    }
