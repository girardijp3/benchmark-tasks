#usda 1.0
(
    defaultPrim = "Tablet"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Tablet" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    doc = "A 20 x 9 x 7.5 mm piece of a scored white caplet, 1.8 g. Origin at its centre."
)
{
    point3f physics:centerOfMass = (0, 0, 0)
    float3 physics:diagonalInertia = (6.84375e-8, 2.05875e-8, 7.215e-8)
    float physics:mass = 0.0018

    def Scope "Looks"
    {
        def Material "Phys_tab" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.5
            float physics:restitution = 0
            float physics:staticFriction = 0.6
        }

        def Material "m959489"
        {
            token outputs:surface.connect = </Tablet/Looks/m959489/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.96, 0.95, 0.9)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "m545349"
        {
            token outputs:surface.connect = </Tablet/Looks/m545349/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.54, 0.5)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }
    }

    def Cube "Box1" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </Tablet/Looks/m959489>
        rel material:binding:physics = </Tablet/Looks/Phys_tab> (
            bindMaterialAs = "weakerThanDescendants"
        )
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.009, 0.02, 0.0075)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Box2" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Tablet/Looks/m545349>
        double size = 1
        float3 xformOp:scale = (0.008, 0.0005, 0.0002)
        double3 xformOp:translate = (0, 0, 0.0038)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}

