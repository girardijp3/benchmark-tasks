#usda 1.0
(
    defaultPrim = "PackJig_2x2"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "PackJig_2x2" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
    doc = "PLA assembly jig for a 2x2 18650 pack, 76 x 76 x 6 mm, screwed to the bench (spawn it kinematic): a 42 x 42 x 3 mm pocket on a 3 mm floor (0.4 mm a side around the 41.2 mm holder), 1 mm 45 deg lead-in, a 20 mm finger slot through each side wall. Origin at the bottom face's centre; the pocket floor is 3 mm up."
)
{
    float physics:mass = 0.018456878
    custom float physxRigidBody:maxDepenetrationVelocity = 0.2
    custom float physxRigidBody:sleepThreshold = 0.00005
    custom int physxRigidBody:solverPositionIterationCount = 32
    custom int physxRigidBody:solverVelocityIterationCount = 4

    def "Looks"
    {
        def Material "PLA_Orange"
        {
            token outputs:surface.connect = </PackJig_2x2/Looks/PLA_Orange/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.25, 0.03)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "Ink_White"
        {
            token outputs:surface.connect = </PackJig_2x2/Looks/Ink_White/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.85, 0.85, 0.82)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "Steel_Black"
        {
            token outputs:surface.connect = </PackJig_2x2/Looks/Steel_Black/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.05, 0.05, 0.055)
                float inputs:metallic = 0.8
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "Phys_PLA" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.4
            float physics:restitution = 0
            float physics:staticFriction = 0.45
        }
    }

    def Mesh "Jig" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
