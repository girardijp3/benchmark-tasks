def Xform "Hood" (
    delete apiSchemas = ["PhysicsMassAPI", "PhysicsRigidBodyAPI"]
    doc = "A fixed range-hood filter panel leaning back 60 degrees from vertical: back plate, a bottom trough with a front lip and lead-in, and a top spring latch (a plate on a prismatic joint along the panel, spring 150 N/m with a 3 N preload, pull handle, visible coil). Origin: table level; x forward from the arms' midpoint."
)
{
    point3f physics:centerOfMass = (0.37, 0, 0.1)
    float3 physics:diagonalInertia = (0.1, 0.1, 0.1)
