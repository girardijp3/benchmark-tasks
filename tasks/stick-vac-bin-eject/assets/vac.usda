    def PhysicsPrismaticJoint "EjectPress" (
        prepend apiSchemas = ["PhysicsDriveAPI:linear"]
        doc = "Red bin-release button: 0 = out (latched), +10 mm = pressed (bin released). 600 N/m = 6 N at the stop; the spring returns it to 0 when let go (the click)."
    )
    {
        float drive:linear:physics:damping = 1
        float drive:linear:physics:stiffness = 600
        float drive:linear:physics:targetPosition = 0
        uniform token drive:linear:physics:type = "force"
        uniform token physics:axis = "X"
        rel physics:body0 = </StickVac/Body>
        rel physics:body1 = </StickVac/Eject>
        point3f physics:localPos0 = (-0.058, 0, 0.215)
        point3f physics:localPos1 = (0, 0, 0)
        quatf physics:localRot0 = (1, 0, 0, 0)
        quatf physics:localRot1 = (1, 0, 0, 0)
        float physics:lowerLimit = 0
        float physics:upperLimit = 0.01
    }
