#usda 1.0
(
    defaultPrim = "StickVac"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "StickVac" (
    doc = "Dyson V6-class cordless stick-vacuum motor/body module on the bench: a 120 x 150 x 195 mm housing with a front cradle for the 0.4 L clear bin, a red spring bin-release button (600 N/m, 10 mm, 6 N) on the front top, and a fixed wand/floor-head prop. The body is a free articulation; the button is a prismatic link. Origin at the middle of the body footprint on the bench."
)
{
    def Scope "Looks"
    {
        def Material "Phys_rubber" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 1
            float physics:restitution = 0
            float physics:staticFriction = 1.2
        }

        def Material "m090910"
        {
            token outputs:surface.connect = </StickVac/Looks/m090910/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.1, 0.11)
                float inputs:metallic = 0
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "Phys_plastic" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.35
            float physics:restitution = 0
            float physics:staticFriction = 0.45
        }

