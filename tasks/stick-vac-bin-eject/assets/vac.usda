            custom float physxCollision:contactOffset = 0.0008
            custom float physxCollision:restOffset = 0
            double size = 1
            float3 xformOp:scale = (0.024, 0.024, 0.01)
            double3 xformOp:translate = (-0.045, -0.058, 0.005)
