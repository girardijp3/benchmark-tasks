#usda 1.0
(
    defaultPrim = "DustBin"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "DustBin" (
    doc = "Dyson V6-class 0.4 L clear dust bin: a 70 x 70 x 85 mm clear plastic box (0.42 L) with a sealed top, two rubber grip ribs at the sides, and a hinged bottom dump flap (0 = shut, -100 deg = open). Origin at the centre of the bottom face. Free articulation; six loose pieces of dust ride inside."
)
{
    def Scope "Looks"
    {
        def Material "Phys_plastic" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.35
            float physics:restitution = 0
            float physics:staticFriction = 0.45
        }

        def Material "m546977"
        {
            token outputs:surface.connect = </DustBin/Looks/m546977/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.7, 0.78)
                float inputs:metallic = 0
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "m171921"
        {
            token outputs:surface.connect = </DustBin/Looks/m171921/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.18, 0.2, 0.22)
                float inputs:metallic = 0
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "m111112"
        {
            token outputs:surface.connect = </DustBin/Looks/m111112/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.12, 0.12, 0.13)
                float inputs:metallic = 0
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "m840909"
        {
            token outputs:surface.connect = </DustBin/Looks/m840909/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.85, 0.1, 0.1)
                float inputs:metallic = 0
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "m919189"
        {
            token outputs:surface.connect = </DustBin/Looks/m919189/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.92, 0.92, 0.9)
                float inputs:metallic = 0
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "Phys_rubber" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.8
            float physics:restitution = 0
            float physics:staticFriction = 0.9
        }
    }

    def Xform "Can" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsArticulationRootAPI"]
    )
    {
        point3f physics:centerOfMass = (0, 0, 0.0425)
        float3 physics:diagonalInertia = (0.00014145834, 0.00014145834, 0.000114333336)
        float physics:mass = 0.14
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "WallY1" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding = </DustBin/Looks/m546977>
            rel material:binding:physics = </DustBin/Looks/Phys_plastic> (
                bindMaterialAs = "weakerThanDescendants"
            )
            custom float physxCollision:contactOffset = 0.0008
            custom float physxCollision:restOffset = 0
            double size = 1
            float3 xformOp:scale = (0.07, 0.004, 0.081)
            double3 xformOp:translate = (0, -0.033, 0.0425)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

