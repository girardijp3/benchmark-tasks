    def Xform "Flap" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (-0.035, 0, 0.002)
        float3 physics:diagonalInertia = (0.000008193333, 0.000008193333, 0.000016333333)
        float physics:mass = 0.02
        double3 xformOp:translate = (0.035, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "FlapPlate16" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding = </DustBin/Looks/m546977>
            rel material:binding:physics = </DustBin/Looks/Phys_plastic> (
                bindMaterialAs = "weakerThanDescendants"
            )
            custom float physxCollision:contactOffset = 0.0008
            custom float physxCollision:restOffset = 0
            double size = 1
            float3 xformOp:scale = (0.07, 0.07, 0.004)
            double3 xformOp:translate = (-0.035, 0, 0.002)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cylinder "FlapTab17" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            uniform token axis = "Y"
            double height = 0.014
            rel material:binding = </DustBin/Looks/m840909>
            rel material:binding:physics = </DustBin/Looks/Phys_plastic> (
                bindMaterialAs = "weakerThanDescendants"
            )
            custom float physxCollision:contactOffset = 0.0008
            custom float physxCollision:restOffset = 0
            double radius = 0.006
            double3 xformOp:translate = (-0.064, 0, 0.002)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
