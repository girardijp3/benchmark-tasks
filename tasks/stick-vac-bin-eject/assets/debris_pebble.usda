#usda 1.0
(
    defaultPrim = "DebrisPebble"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "DebrisPebble" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    doc = "A light piece of real vacuum debris (dust grit / dry leaf fragment), a free rigid body."
)
{
    point3f physics:centerOfMass = (0, 0, 0)
    float3 physics:diagonalInertia = (1.5083333e-7, 1.875e-7, 2.0333333e-7)
    float physics:mass = 0.01

    def Scope "Looks"
    {
        def Material "Phys_debris" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.5
            float physics:restitution = 0
            float physics:staticFriction = 0.6
        }

        def Material "m322619"
        {
            token outputs:surface.connect = </DebrisPebble/Looks/m322619/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.33, 0.27, 0.2)
                float inputs:metallic = 0
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }
    }

    def Cube "Debris1" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </DebrisPebble/Looks/m322619>
        rel material:binding:physics = </DebrisPebble/Looks/Phys_debris> (
            bindMaterialAs = "weakerThanDescendants"
        )
        custom float physxCollision:contactOffset = 0.0008
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.012, 0.01, 0.009)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}

