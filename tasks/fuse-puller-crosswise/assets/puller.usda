#usda 1.0
(
    defaultPrim = "Puller"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Puller" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsArticulationRootAPI"]
    doc = "A tweezer-type fuse puller: a head block and two 3 mm arms 100 mm long and 12 mm tall hinged about Z at (2 mm, +-10.5 mm), with jaw plates (28 mm long, inner faces 14 mm apart open); joints ArmP and ArmM, springs to the open stops. Free root. Origin: table level at the hinge line, middle; jaws toward +x."
)
{
    point3f physics:centerOfMass = (0.02, 0, 0.006)
    float3 physics:diagonalInertia = (0.00002, 0.00002, 0.00002)
    float physics:mass = 0.03

    def Scope "Looks"
    {
        def Material "Phys_puller" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.5
            float physics:restitution = 0
            float physics:staticFriction = 0.6
        }

        def Material "m811107"
        {
            token outputs:surface.connect = </Puller/Looks/m811107/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.82, 0.12, 0.08)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "m777880"
        {
            token outputs:surface.connect = </Puller/Looks/m777880/PreviewSurface.outputs:surface>

