#usda 1.0
(
    defaultPrim = "Block"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Block" (
    delete apiSchemas = ["PhysicsArticulationRootAPI", "PhysicsMassAPI", "PhysicsRigidBodyAPI"]
    doc = "A fuse block lying on the table: a 52 x 84 x 20 mm base with three fuse pockets 28 mm apart along y (each 30.6 x 9.5 x 12 mm deep with two spring clips, joints Clip<A|B|C><P|M>, prismatic along y; the fuses are separate free bodies) and a 54 mm square tray 110 mm to +y and 50 mm to -x. Fixed root. Origin: table level, middle of the base."
)
{
    def Scope "Looks"
    {
        def Material "Phys_base" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.3
            float physics:restitution = 0
            float physics:staticFriction = 0.35
        }

        def Material "Phys_tray" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.3
            float physics:restitution = 0
            float physics:staticFriction = 0.35
        }

        def Material "m101112"
        {
            token outputs:surface.connect = </Block/Looks/m101112/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.11, 0.12, 0.13)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "m777880"
        {
            token outputs:surface.connect = </Block/Looks/m777880/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.78, 0.79, 0.81)
                float inputs:metallic = 0.9
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "m737578"
        {
            token outputs:surface.connect = </Block/Looks/m737578/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.74, 0.76, 0.79)
                float inputs:metallic = 0.9
                float inputs:roughness = 0.32
                token outputs:surface
            }
        }

        def Material "Phys_clip" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.45
            float physics:restitution = 0
            float physics:staticFriction = 0.5
        }

        def Material "m714419"
        {
            token outputs:surface.connect = </Block/Looks/m714419/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.72, 0.45, 0.2)
                float inputs:metallic = 0.85
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }
    }

    def Xform "ClipAP" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (0, 0, 0)
        float3 physics:diagonalInertia = (1e-7, 1e-7, 1e-7)
        float physics:mass = 0.003
        double3 xformOp:translate = (0, -0.02375, 0.014)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "Tooth41" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding = </Block/Looks/m714419>
            rel material:binding:physics = </Block/Looks/Phys_clip> (
                bindMaterialAs = "weakerThanDescendants"
            )
            custom float physxCollision:contactOffset = 0.001
            custom float physxCollision:restOffset = 0
            double size = 1
            float3 xformOp:scale = (0.008, 0.003, 0.008)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

