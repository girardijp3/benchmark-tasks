#usda 1.0
(
    defaultPrim = "Gusset"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Gusset" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    doc = "100 mm steel angle-bracket gusset (foot + upright + web)"
)
{
    point3f physics:centerOfMass = (0, 0, 0)
    float3 physics:diagonalInertia = (0.000001, 0.000001, 0.000001)
    float physics:mass = 0.21
    custom bool physxRigidBody:disableGravity = 1

    def Scope "Looks"
    {
        def Material "m616467_63"
        {
            token outputs:surface.connect = </Gusset/Looks/m616467_63/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.62, 0.65, 0.68)
                float inputs:metallic = 0.7
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "m616467_65"
        {
            token outputs:surface.connect = </Gusset/Looks/m616467_65/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.62, 0.65, 0.68)
                float inputs:metallic = 0.7
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }
    }

    def Cube "Foot1" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </Gusset/Looks/m616467_63>
        custom float physxCollision:contactOffset = 0.0005
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.1, 0.03, 0.004)
        double3 xformOp:translate = (0, 0.015, 0.002)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Upright2" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </Gusset/Looks/m616467_63>
        custom float physxCollision:contactOffset = 0.0005
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.1, 0.004, 0.1)
        double3 xformOp:translate = (0, -0.002, 0.05)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "WebLow03" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Gusset/Looks/m616467_65>
        double size = 1
        float3 xformOp:scale = (0.006, 0.018, 0.004)
        double3 xformOp:translate = (-0.03, 0.01, 0.01)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "WebMid04" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Gusset/Looks/m616467_65>
        double size = 1
        float3 xformOp:scale = (0.006, 0.01, 0.004)
        double3 xformOp:translate = (-0.03, 0.006, 0.022)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "WebLow15" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Gusset/Looks/m616467_65>
        double size = 1
        float3 xformOp:scale = (0.006, 0.018, 0.004)
        double3 xformOp:translate = (0.03, 0.01, 0.01)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "WebMid16" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Gusset/Looks/m616467_65>
        double size = 1
        float3 xformOp:scale = (0.006, 0.01, 0.004)
        double3 xformOp:translate = (0.03, 0.006, 0.022)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}

