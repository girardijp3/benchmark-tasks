    def PhysicsRevoluteJoint "HingeP" (
        prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        doc = "Latch hinge: 0 = hook over the fan's top edge (inner stop); the spring pushes 2 deg past the stop."
    )
    {
        float drive:angular:physics:damping = 0.00005235988
        float drive:angular:physics:stiffness = 0.0015707964
        float drive:angular:physics:targetPosition = 2
        uniform token drive:angular:physics:type = "force"
        uniform token physics:axis = "X"
        rel physics:body0 = </FanBracket/Base>
        rel physics:body1 = </FanBracket/LatchP>
        point3f physics:localPos0 = (0, 0.0655, 0.009)
        point3f physics:localPos1 = (0, 0, 0)
        quatf physics:localRot0 = (1, 0, 0, 0)
        quatf physics:localRot1 = (1, 0, 0, 0)
        float physics:lowerLimit = -20
        float physics:upperLimit = 0
    }

