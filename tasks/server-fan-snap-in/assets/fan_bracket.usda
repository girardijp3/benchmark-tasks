#usda 1.0
(
    defaultPrim = "FanBracket"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "FanBracket" (
    doc = "A tool-less bracket for a 120 mm case fan, one articulation: a fixed base (a 147 mm square ring 6 mm high with four L-shaped corner posts, 127 mm opening, 40 mm walls with 6 mm lead-in bevels) and two spring latches (34 mm arms on hinges along x, 7.5 mm hooks 22.6 mm over their hinges) on the middle of the two sides along x. Each latch rests against its inner stop (angle 0) under a 0.09 N m/rad spring preloaded 2 degrees and swings outward 20 degrees at most: positive angle opens the -y latch, negative the +y latch. Origin on the table at the fan's axis."
)
{
    def Scope "Looks"
    {
        def Material "Phys_plastic" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.35
            float physics:restitution = 0
            float physics:staticFriction = 0.45
        }

        def Material "m151619"
        {
            token outputs:surface.connect = </FanBracket/Looks/m151619/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.16, 0.17, 0.2)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "m844409"
        {
            token outputs:surface.connect = </FanBracket/Looks/m844409/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.85, 0.45, 0.1)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "Phys_hook" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.25
            float physics:restitution = 0
            float physics:staticFriction = 0.3
        }
    }

