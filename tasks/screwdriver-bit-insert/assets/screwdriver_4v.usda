#usda 1.0
(
    defaultPrim = "Screwdriver"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Screwdriver" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI"]
    doc = "4 V pen-style cordless screwdriver, 27 mm across, 145 mm long, 230 g. Origin at the battery end's face centre, +Z toward the nose; the battery end's key rib faces -X. Its nose holds a 1/4-inch hex magnetic bit holder: hex socket 6.45 mm across flats (flats facing +-X), 10.6 mm deep with a 0.6 mm lead-in, colliding as exact boxes, with a sprung retaining ball (compliant contact) for the magnet."
)
{
    point3f physics:centerOfMass = (0, 0, 0.062)
    float3 physics:diagonalInertia = (0.00002095875, 0.00041345853, 0.00041345853)
    float physics:mass = 0.23
    quatf physics:principalAxes = (0.70710677, 0, 0.70710677, 0)
    custom float physxRigidBody:maxDepenetrationVelocity = 0.5
    custom float physxRigidBody:sleepThreshold = 0.00005
    custom int physxRigidBody:solverPositionIterationCount = 32
    custom int physxRigidBody:solverVelocityIterationCount = 4

    def Scope "Looks"
    {
        def Material "black"
        {
            token outputs:surface.connect = </Screwdriver/Looks/black/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.018, 0.018, 0.02)
                float inputs:metallic = 0
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "body"
        {
            token outputs:surface.connect = </Screwdriver/Looks/body/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.048171826, 0.13286832, 0.16202937)
                float inputs:metallic = 0
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "rubber"
        {
            token outputs:surface.connect = </Screwdriver/Looks/rubber/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.012, 0.012, 0.013)
                float inputs:metallic = 0
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }

        def Material "chuck"
        {
            token outputs:surface.connect = </Screwdriver/Looks/chuck/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.035, 0.035, 0.04)
                float inputs:metallic = 0.85
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "magnet"
        {
            token outputs:surface.connect = </Screwdriver/Looks/magnet/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.55, 0.53)
                float inputs:metallic = 1
                float inputs:roughness = 0.25
                token outputs:surface
            }
        }

        def Material "led_ring"
        {
            token outputs:surface.connect = </Screwdriver/Looks/led_ring/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.8, 0.75)
                color3f inputs:emissiveColor = (0.48, 0.48, 0.45)
                float inputs:metallic = 0
                float inputs:roughness = 0.2
                token outputs:surface
            }
        }

        def Material "led_green"
        {
            token outputs:surface.connect = </Screwdriver/Looks/led_green/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.05, 0.6, 0.12)
                color3f inputs:emissiveColor = (0.03, 0.36, 0.072)
                float inputs:metallic = 0
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "label_sd"
        {
            token outputs:surface.connect = </Screwdriver/Looks/label_sd/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </Screwdriver/Looks/label_sd/Texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.45
                token outputs:surface
            }

            def Shader "stReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/screwdriver_label.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Screwdriver/Looks/label_sd/stReader.outputs:result>
                token inputs:wrapS = "clamp"
                token inputs:wrapT = "clamp"
                float3 outputs:rgb
            }
        }

        def Material "gold"
        {
            token outputs:surface.connect = </Screwdriver/Looks/gold/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.85, 0.62, 0.25)
                float inputs:metallic = 1
                float inputs:roughness = 0.25
                token outputs:surface
            }
        }

        def Material "Phys_ABS" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.4
            float physics:restitution = 0
            float physics:staticFriction = 0.45
        }

        def Material "Phys_TPE_Grip" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.9
            float physics:restitution = 0
            float physics:staticFriction = 1
        }

        def Material "Phys_Steel" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.2
            float physics:restitution = 0
            float physics:staticFriction = 0.25
        }

        def Material "Phys_Detent" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.25
            float physics:restitution = 0
            float physics:staticFriction = 0.3
            custom float physxMaterial:compliantContactDamping = 3
            custom float physxMaterial:compliantContactStiffness = 4000
        }
    }

    def Scope "Colliders"
    {
