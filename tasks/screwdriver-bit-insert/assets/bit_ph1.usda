#usda 1.0
(
    defaultPrim = "Bit_PH1"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Bit_PH1" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI"]
    doc = "25 mm 1/4-inch hex insert bit, PH1, S2 steel with a colour ring (2E9E4A). Origin at the shank's end face centre, +Z toward the tip; flats face +-X. The hex shank collides as exact boxes: three crossed boxes make the 6.35 mm hexagon (and three of 5.75 mm its first 0.4 mm, for the end chamfer); the tip as a small convex hull inside the hexagon."
)
{
    point3f physics:centerOfMass = (9.399045e-21, 5.521939e-20, 0.010196235)
    float3 physics:diagonalInertia = (3.0154556e-8, 2.0829447e-7, 2.0829447e-7)
    float physics:mass = 0.005544879
    quatf physics:principalAxes = (-0.70710677, 0.0001575854, 0.70710677, 0.0001575854)
    custom float physxRigidBody:maxDepenetrationVelocity = 0.5
    custom float physxRigidBody:sleepThreshold = 0.00005
    custom int physxRigidBody:solverPositionIterationCount = 32
    custom int physxRigidBody:solverVelocityIterationCount = 4

    def Scope "Looks"
    {
        def Material "steel"
        {
            token outputs:surface.connect = </Bit_PH1/Looks/steel/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.56, 0.57, 0.59)
                float inputs:metallic = 1
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "ring_ph1"
        {
            token outputs:surface.connect = </Bit_PH1/Looks/ring_ph1/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.027320892, 0.34191442, 0.06847817)
                float inputs:metallic = 0
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "Phys_ToolSteel" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.25
            float physics:restitution = 0
            float physics:staticFriction = 0.3
        }
    }

    def Scope "Colliders"
    {
        def Cube "ShankEnd_0" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </Bit_PH1/Looks/Phys_ToolSteel> (
                bindMaterialAs = "weakerThanDescendants"
            )
            custom float physxCollision:contactOffset = 0.0002
            custom float physxCollision:restOffset = 0
            uniform token purpose = "guide"
            double size = 1
            quatf xformOp:orient = (1, 0, 0, 0)
