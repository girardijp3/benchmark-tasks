#usda 1.0
(
    defaultPrim = "ScrewdriverDock"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "ScrewdriverDock" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI"]
    doc = "Charging dock for the 4 V pen screwdriver: a 76 mm round base, 8 mm high, with a cup tower 36 mm across and 32 mm high; the cup (floor 3 mm up, sunk into the base) holds the screwdriver upright with 0.15 mm clearance, a keyway on -X taking its rib. Origin at the base's bottom centre. Spawned kinematic (fixed to the bench)."
)
{
    point3f physics:centerOfMass = (0, 0, 0.01)
    float3 physics:diagonalInertia = (0.00011, 0.00012, 0.00012)
    float physics:mass = 0.15
    quatf physics:principalAxes = (0.70710677, 0, 0.70710677, 0)
    custom float physxRigidBody:maxDepenetrationVelocity = 0.5
    custom float physxRigidBody:sleepThreshold = 0.00005
    custom int physxRigidBody:solverPositionIterationCount = 32
    custom int physxRigidBody:solverVelocityIterationCount = 4

    def Scope "Looks"
    {
        def Material "black"
        {
            token outputs:surface.connect = </ScrewdriverDock/Looks/black/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.018, 0.018, 0.02)
                float inputs:metallic = 0
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "accent"
        {
            token outputs:surface.connect = </ScrewdriverDock/Looks/accent/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.02842604, 0.3712377, 0.39157248)
                float inputs:metallic = 0
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "led_green"
        {
            token outputs:surface.connect = </ScrewdriverDock/Looks/led_green/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.05, 0.6, 0.12)
                color3f inputs:emissiveColor = (0.03, 0.36, 0.072)
                float inputs:metallic = 0
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "gold"
        {
            token outputs:surface.connect = </ScrewdriverDock/Looks/gold/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.85, 0.62, 0.25)
                float inputs:metallic = 1
                float inputs:roughness = 0.25
                token outputs:surface
            }
        }

        def Material "rubber"
        {
            token outputs:surface.connect = </ScrewdriverDock/Looks/rubber/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.012, 0.012, 0.013)
                float inputs:metallic = 0
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }

        def Material "Phys_ABS" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.4
            float physics:restitution = 0
            float physics:staticFriction = 0.45
        }
    }

