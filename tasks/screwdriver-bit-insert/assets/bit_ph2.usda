#usda 1.0
(
    defaultPrim = "Bit_PH2"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Bit_PH2" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI"]
    doc = "25 mm 1/4-inch hex insert bit, PH2, S2 steel with a colour ring (D62A1E). Origin at the shank's end face centre, +Z toward the tip; flats face +-X. The hex shank collides as exact boxes: three crossed boxes make the 6.35 mm hexagon (and three of 5.75 mm its first 0.4 mm, for the end chamfer); the tip as a small convex hull inside the hexagon."
)
{
    point3f physics:centerOfMass = (1.336442e-21, 2.9379743e-20, 0.010368385)
    float3 physics:diagonalInertia = (3.0583028e-8, 2.189782e-7, 2.189782e-7)
    float physics:mass = 0.0056344764
    quatf physics:principalAxes = (-0.70710677, -0.000061627616, 0.70710677, -0.000061627616)
    custom float physxRigidBody:maxDepenetrationVelocity = 0.5
    custom float physxRigidBody:sleepThreshold = 0.00005
    custom int physxRigidBody:solverPositionIterationCount = 32
    custom int physxRigidBody:solverVelocityIterationCount = 4

    def Scope "Looks"
    {
        def Material "steel"
        {
            token outputs:surface.connect = </Bit_PH2/Looks/steel/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.56, 0.57, 0.59)
                float inputs:metallic = 1
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "ring_ph2"
        {
            token outputs:surface.connect = </Bit_PH2/Looks/ring_ph2/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.67244315, 0.023153367, 0.0129830325)
                float inputs:metallic = 0
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "Phys_ToolSteel" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.25
            float physics:restitution = 0
            float physics:staticFriction = 0.3
        }
    }

    def Scope "Colliders"
    {
        def Cube "ShankEnd_0" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </Bit_PH2/Looks/Phys_ToolSteel> (
                bindMaterialAs = "weakerThanDescendants"
            )
            custom float physxCollision:contactOffset = 0.0002
            custom float physxCollision:restOffset = 0
            uniform token purpose = "guide"
            double size = 1
            quatf xformOp:orient = (1, 0, 0, 0)
            float3 xformOp:scale = (0.00575, 0.003319764, 0.0004)
            double3 xformOp:translate = (0, 0, 0.0002)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        }

