#usda 1.0
(
    defaultPrim = "Paste"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Paste" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsArticulationRootAPI"]
    doc = "The old thermal paste on the IHS: 122 cells of 2 x 2 x 0.05 mm inside a 30 x 20 mm ellipse, grey, on 0.5 mm slides so a clean cell sinks into the lid.  Visual only; the pad's real contact with the IHS and its rubbing remove cells (see task.json fidelity).  Origin: IHS top."
)
{
    point3f physics:centerOfMass = (0, 0, 0)
    float3 physics:diagonalInertia = (1e-7, 1e-7, 1e-7)
    float physics:mass = 0.001
    custom bool physxRigidBody:disableGravity = 1

    def Scope "Looks"
    {
        def Material "Phys_paste" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.6
            float physics:restitution = 0
            float physics:staticFriction = 0.8
        }

        def Material "m343331"
        {
            token outputs:surface.connect = </Paste/Looks/m343331/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.345, 0.34, 0.32)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }
    }

    def Xform "C0" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (0, 0, 0)
        float3 physics:diagonalInertia = (1e-12, 1e-12, 1e-12)
        float physics:mass = 0.000001
        double3 xformOp:translate = (-0.005999999999999998, -0.009000000000000001, 0.000025)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "Cell1" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Paste/Looks/m343331>
            double size = 1
            float3 xformOp:scale = (0.00198, 0.00198, 0.00005)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Scope "Joints"
    {
        def PhysicsPrismaticJoint "C0" (
            prepend apiSchemas = ["PhysicsDriveAPI:linear"]
        )
        {
            float drive:linear:physics:damping = 2
            float drive:linear:physics:stiffness = 50
            float drive:linear:physics:targetPosition = 0
            uniform token drive:linear:physics:type = "force"
            uniform token physics:axis = "Z"
            rel physics:body0 = </Paste>
            rel physics:body1 = </Paste/C0>
            point3f physics:localPos0 = (-0.006, -0.009, 0.000025)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -0.0005
            float physics:upperLimit = 0
        }

