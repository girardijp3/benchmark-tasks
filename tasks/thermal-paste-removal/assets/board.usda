def Xform "Board" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    doc = "ATX 305 x 244 x 1.6 mm motherboard on 6.5 mm brass standoffs: dark-green PCB with silkscreen and traces, a black AM4 socket (54 x 54 mm frame, 40.2 mm opening), its steel load plate and lever, the 54 x 90 mm cooler holes, four DDR4 DIMM slots, the 24-pin ATX header, two VRM heatsinks, the chipset heatsink, two PCIe slots, an M.2 slot, capacitors and the rear I/O shield.  Fixed."
)
{
    point3f physics:centerOfMass = (0, 0, 0.015)
