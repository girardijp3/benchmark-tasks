#usda 1.0
(
    defaultPrim = "Bench"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Bench" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    doc = "The PC-repair bench: a 500 x 440 x 3 mm dark anti-static mat at (0.36, -0.07), a 80 x 80 x 3 mm blue wipe tray at (0.24, -0.24) with its foil packet, a 80 x 80 x 3 mm grey waste tray at (0.46, -0.24), an Arctic MX-4-class 4 g paste tube at (0.18, 0.10), the CPU's box at (0.56, 0.10), a Phillips #2 screwdriver at (0.54, -0.16), a folded-wipe packet at (0.15, -0.02) and an anti-static bag at (0.14, -0.06).  All fixed; the mat alone carries the board's standoffs."
)
{
    point3f physics:centerOfMass = (0, 0, 0.02)
    float3 physics:diagonalInertia = (1, 1, 1)
