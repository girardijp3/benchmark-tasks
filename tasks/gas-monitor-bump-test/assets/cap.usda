(
    defaultPrim = "CalCap"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "CalCap" (
    delete apiSchemas = ["PhysicsMassAPI", "PhysicsRigidBodyAPI"]
    doc = "The MSA 10089321 calibration cap: a black 62 x 84 x 12 mm shell with a silicone gasket, two side snap tabs on revolute joints and a 6 mm hose barb, with one foot of 6 mm hose (8 links on spherical joints). Free articulation: cap body (root), the two tabs and the hose links. Origin: the middle of the sealing face, z up."
)
{
