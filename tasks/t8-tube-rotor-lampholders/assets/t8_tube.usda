def Xform "T8Tube" (
    delete apiSchemas = ["PhysicsMassAPI", "PhysicsRigidBodyAPI"]
    doc = "A T8 fluorescent tube, 26 mm x 590 mm cap to cap, G13 bi-pins (2.47 mm, 12.7 mm apart, 7.5 mm out of each end), 0.13 kg. Free root; four visual strips on prismatic joints show when it is lit. Origin: the tube's middle, y along the tube, pins along x at 0 degrees."
)
{
    point3f physics:centerOfMass = (0, 0, 0)
    float3 physics:diagonalInertia = (0.003776576, 0.00002197, 0.003776576)
    float physics:mass = 0.1296

    def Scope "Looks"
    {
        def Material "Phys_glass" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.5
            float physics:restitution = 0
            float physics:staticFriction = 0.6
        }

        def Material "m969693"
        {
            token outputs:surface.connect = </T8Tube/Looks/m969693/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.97, 0.97, 0.94)
                float inputs:metallic = 0
                float inputs:roughness = 0.22
                token outputs:surface
            }
        }

        def Material "m777879"
        {
            token outputs:surface.connect = </T8Tube/Looks/m777879/PreviewSurface.outputs:surface>

