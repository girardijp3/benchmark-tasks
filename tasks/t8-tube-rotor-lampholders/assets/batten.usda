#usda 1.0
(
    defaultPrim = "Batten"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Batten" (
    delete apiSchemas = ["PhysicsMassAPI", "PhysicsRigidBodyAPI"]
    doc = "A fixed 600 mm T8 batten on a back board with two G13 rotor lampholders. Each holder: a housing with a round 10 mm pocket, an entry notch from the front with a lead-in, and a rotor (9.4 mm) with a 3.2 mm diametral slot on a revolute joint about y. The notch lines up with the slot at 0 degrees; at -90 degrees the pins are behind the pocket wall. Origin: table level on the tube's axis, y 0 midway."
)
{
    point3f physics:centerOfMass = (0.03, 0, 0.1)
    float3 physics:diagonalInertia = (0.1, 0.1, 0.1)
    float physics:mass = 2

    def Scope "Looks"
    {
        def Material "Phys_pan" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.25
            float physics:restitution = 0
            float physics:staticFriction = 0.3
        }

        def Material "m959594"
        {
            token outputs:surface.connect = </Batten/Looks/m959594/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.96, 0.96, 0.95)
                float inputs:metallic = 0
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "Phys_wood" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.25
            float physics:restitution = 0
