#usda 1.0
(
    defaultPrim = "CoverCracked"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "CoverCracked" (
    doc = "The bay's original top cover: grey ABS, 150 x 100 mm, 20 mm skirt, 3 mm plate with three keyholes, finger rib on top, a cracked plate (crack lines drawn only). 100 g. Origin: the middle of the skirt's lower edge."
)
{
    def Scope "Looks"
    {
        def Material "Shell"
        {
            token outputs:surface.connect = </CoverCracked/Looks/Shell/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.57, 0.6)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
        def Material "Rib"
        {
            token outputs:surface.connect = </CoverCracked/Looks/Rib/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.44, 0.456, 0.48)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
        def Material "Crack"
        {
            token outputs:surface.connect = </CoverCracked/Looks/Crack/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.45, 0.02, 0.02)
                float inputs:metallic = 0
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }
        def Material "Label"
        {
            token outputs:surface.connect = </CoverCracked/Looks/Label/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.55, 0.25)
                float inputs:metallic = 0
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }
        def Material "Phys_Abs" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.35
            float physics:restitution = 0
            float physics:staticFriction = 0.45
        }
    }

    def Xform "Cover" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        doc = "The bay's original top cover: grey ABS, 150 x 100 mm, 20 mm skirt, 3 mm plate with three keyholes, finger rib on top, a cracked plate (crack lines drawn only). 100 g. Origin: the middle of the skirt's lower edge."
    )
    {
        float physics:mass = 0.1
        point3f physics:centerOfMass = (0, 0, 0.012)
        custom float physxRigidBody:maxDepenetrationVelocity = 0.2
