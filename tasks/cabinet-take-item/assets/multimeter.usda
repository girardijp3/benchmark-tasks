#usda 1.0
(
    defaultPrim = "Multimeter"
    doc = "Handheld 6000-count digital multimeter in a yellow rubber boot, 186 x 89 x 49 mm, 400 g (generic, no brand). Origin: middle of its bottom end; x across its width, y through its thickness (display on +y), z up its length. Collider: its own chamfered box, 24 points."
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Multimeter" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI"]
)
{
    point3f physics:centerOfMass = (0, 0, 0.088)
    float3 physics:diagonalInertia = (0.0012332334, 0.0014172334, 0.00034406668)
    float physics:mass = 0.4
    quatf physics:principalAxes = (1, 0, 0, 0)
    custom float physxRigidBody:maxDepenetrationVelocity = 0.5
    custom int physxRigidBody:solverPositionIterationCount = 32
    custom int physxRigidBody:solverVelocityIterationCount = 4

    def Scope "Looks"
    {
        def Material "DialMark"
        {
            token outputs:surface.connect = </Multimeter/Looks/DialMark/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.8, 0.2)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "Hole"
        {
            token outputs:surface.connect = </Multimeter/Looks/Hole/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.01, 0.01, 0.01)
                float inputs:metallic = 0
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }

        def Material "Holster"
        {
            token outputs:surface.connect = </Multimeter/Looks/Holster/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9, 0.4, 0.012)
                float inputs:metallic = 0
                float inputs:roughness = 0.75
                token outputs:surface
            }
        }

        def Material "JackBlack"
        {
            token outputs:surface.connect = </Multimeter/Looks/JackBlack/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.04, 0.04, 0.04)
                float inputs:metallic = 0
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "JackRed"
        {
            token outputs:surface.connect = </Multimeter/Looks/JackRed/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.75, 0.06, 0.05)
                float inputs:metallic = 0
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "MeterButton"
        {
            token outputs:surface.connect = </Multimeter/Looks/MeterButton/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.3, 0.33, 0.37)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "MeterDark"
        {
            token outputs:surface.connect = </Multimeter/Looks/MeterDark/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.1, 0.11)
                float inputs:metallic = 0
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "MeterLCD"
        {
            token outputs:surface.connect = </Multimeter/Looks/MeterLCD/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </Multimeter/Looks/MeterLCD/Texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.25
                token outputs:surface
            }

            def Shader "stReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/meter_lcd.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Multimeter/Looks/MeterLCD/stReader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }

        def Material "MeterPanel"
        {
            token outputs:surface.connect = </Multimeter/Looks/MeterPanel/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </Multimeter/Looks/MeterPanel/Texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }

            def Shader "stReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/meter_panel.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Multimeter/Looks/MeterPanel/stReader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }

        def Material "Phys_RubberBoot" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.8
            float physics:restitution = 0
            float physics:staticFriction = 0.9
        }
    }

    def Scope "Visuals"
    {
