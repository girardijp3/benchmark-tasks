#usda 1.0
(
    defaultPrim = "BenchCabinet"
    doc = "Bench-top storage cabinet, birch plywood, 220 x 250 x 356 mm, as one articulation: Carcass (root, rigid), Door (overlay door on a vertical barrel hinge at its left edge, damped, opens 0..120 deg toward the viewer; 128 mm bar pull), Catch (fixed under the top panel). The catch holds the shut door by contact: a 6 mm strike rod on the door rides under the catch's 6 mm lip rod (compliant contact) and, once past it, presses the door shut against the hinge's stop. Origin: middle of the carcass front edge on the bench; +x into the cabinet, +y left, z up."
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "BenchCabinet" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
)
{
    custom bool physxArticulation:enabledSelfCollisions = 1
    custom int physxArticulation:solverPositionIterationCount = 32
    custom int physxArticulation:solverVelocityIterationCount = 1

    def Scope "Looks"
    {
        def Material "BirchEdge"
        {
            token outputs:surface.connect = </BenchCabinet/Looks/BirchEdge/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </BenchCabinet/Looks/BirchEdge/Texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.65
                token outputs:surface
            }

            def Shader "stReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/ply_edge.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </BenchCabinet/Looks/BirchEdge/stReader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }

        def Material "BirchFace"
        {
            token outputs:surface.connect = </BenchCabinet/Looks/BirchFace/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </BenchCabinet/Looks/BirchFace/Texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.55
                token outputs:surface
            }

            def Shader "stReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/birch_face.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </BenchCabinet/Looks/BirchFace/stReader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }

        def Material "Hardboard"
        {
            token outputs:surface.connect = </BenchCabinet/Looks/Hardboard/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.42, 0.29, 0.18)
                float inputs:metallic = 0
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }

        def Material "Label"
        {
            token outputs:surface.connect = </BenchCabinet/Looks/Label/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </BenchCabinet/Looks/Label/Texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }

            def Shader "stReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/door_label.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </BenchCabinet/Looks/Label/stReader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }

        def Material "Nickel"
        {
            token outputs:surface.connect = </BenchCabinet/Looks/Nickel/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.7, 0.7, 0.67)
                float inputs:metallic = 1
                float inputs:roughness = 0.22
                token outputs:surface
            }
        }

        def Material "Rubber"
        {
            token outputs:surface.connect = </BenchCabinet/Looks/Rubber/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.03, 0.03, 0.03)
                float inputs:metallic = 0
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }

        def Material "Steel"
        {
            token outputs:surface.connect = </BenchCabinet/Looks/Steel/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.74, 0.74, 0.73)
                float inputs:metallic = 1
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "WhitePlastic"
        {
            token outputs:surface.connect = </BenchCabinet/Looks/WhitePlastic/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9, 0.9, 0.87)
                float inputs:metallic = 0
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "Zinc"
        {
            token outputs:surface.connect = </BenchCabinet/Looks/Zinc/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.62, 0.64, 0.66)
                float inputs:metallic = 1
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "Phys_Birch" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.4
            float physics:restitution = 0
            float physics:staticFriction = 0.45
        }

        def Material "Phys_RubberFeet" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.8
            float physics:restitution = 0
            float physics:staticFriction = 0.9
        }

        def Material "Phys_Steel" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.4
            float physics:restitution = 0
            float physics:staticFriction = 0.5
        }

        def Material "Phys_Catch" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.15
            float physics:restitution = 0
            float physics:staticFriction = 0.15
            custom float physxMaterial:compliantContactDamping = 15
            custom float physxMaterial:compliantContactStiffness = 3500
        }
    }

