        rel material:binding = </Spring/Looks/m091011_05>
        double radius = 0.003
        double3 xformOp:translate = (0, 0, -0.0032000000000000006)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "Bore35" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
