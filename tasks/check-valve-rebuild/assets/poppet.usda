#usda 1.0
(
    defaultPrim = "Poppet"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Poppet" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    doc = "replacement poppet disc with rubber seal face and guide stem"
)
{
    point3f physics:centerOfMass = (0, 0, 0)
    float3 physics:diagonalInertia = (0.000001, 0.000001, 0.000001)
    float physics:mass = 0.008
    custom bool physxRigidBody:disableGravity = 1

    def Scope "Looks"
    {
        def Material "m697174_55"
        {
            token outputs:surface.connect = </Poppet/Looks/m697174_55/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.7, 0.72, 0.75)
                float inputs:metallic = 0.6
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "m040405_08"
        {
            token outputs:surface.connect = </Poppet/Looks/m040405_08/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.05, 0.05, 0.055)
                float inputs:metallic = 0
                float inputs:roughness = 0.95
                token outputs:surface
            }
        }
    }

    def Cylinder "Disc1" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.003
        rel material:binding = </Poppet/Looks/m697174_55>
        custom float physxCollision:contactOffset = 0.0005
        custom float physxCollision:restOffset = 0
        double radius = 0.008
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "SealFace2" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.0016
        rel material:binding = </Poppet/Looks/m040405_08>
        double radius = 0.007
        double3 xformOp:translate = (0, 0, -0.002)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "GuideStem3" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.014
        rel material:binding = </Poppet/Looks/m697174_55>
        double radius = 0.0025
        double3 xformOp:translate = (0, 0, 0.0095)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}

