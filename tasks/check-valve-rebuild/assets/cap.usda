#usda 1.0
(
    defaultPrim = "Cap"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Cap" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    doc = "threaded brass bonnet / cap of the check valve"
)
{
    point3f physics:centerOfMass = (0, 0, 0)
    float3 physics:diagonalInertia = (0.000001, 0.000001, 0.000001)
    float physics:mass = 0.03
    custom bool physxRigidBody:disableGravity = 1

    def Scope "Looks"
    {
        def Material "m715419_72"
        {
            token outputs:surface.connect = </Cap/Looks/m715419_72/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.72, 0.55, 0.2)
                float inputs:metallic = 0.8
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "m091011_45"
        {
            token outputs:surface.connect = </Cap/Looks/m091011_45/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.11, 0.12)
                float inputs:metallic = 0.5
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "m715419_75"
        {
            token outputs:surface.connect = </Cap/Looks/m715419_75/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.72, 0.55, 0.2)
                float inputs:metallic = 0.8
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }
    }

    def Cylinder "CapHex1" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.014
        rel material:binding = </Cap/Looks/m715419_72>
        custom float physxCollision:contactOffset = 0.0005
        custom float physxCollision:restOffset = 0
        double radius = 0.013
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "Knurl2" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.003
        rel material:binding = </Cap/Looks/m091011_45>
        double radius = 0.0135
        double3 xformOp:translate = (0, 0, 0.006)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "Thread3" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.003
        rel material:binding = </Cap/Looks/m715419_75>
        double radius = 0.006
        double3 xformOp:translate = (0, 0, -0.0075)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}

