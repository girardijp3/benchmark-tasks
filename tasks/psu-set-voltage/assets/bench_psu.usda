#usda 1.0
(
    defaultPrim = "BenchPSU"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "BenchPSU" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
    doc = "Bench DC power supply, 0-30 V / 0-5 A single output, 110 x 151 x 262 mm case (158 mm tall on its feet), 2.5 kg. Origin: the footprint's middle on the table plane; the front panel faces -Y. One articulation, root link Body: PowerButton (prismatic +Y, 0..4.5 mm, a latching push button whose latch the task drives through the spring's target), Knob_V_Coarse (0 rad = 12 V; clockwise from the front is +; 9 deg per volt), Knob_V_Fine, Knob_I_Coarse, Knob_I_Fine (damped, no spring: they stay where turned). Body/Display_V and Display_A: four 7-segment digits each (D<n>_<a-g>, D<n>_dp), authored invisible; Body/Leds/CV_Lit, CC_Lit likewise. Created for this task by its authors, licensed CC-BY 4.0."
)
{
    custom bool physxArticulation:enabledSelfCollisions = 0
    custom int physxArticulation:solverPositionIterationCount = 32
    custom int physxArticulation:solverVelocityIterationCount = 1

    def Scope "Looks"
    {
        def Material "Cover_Paint"
        {
            token outputs:surface.connect = </BenchPSU/Looks/Cover_Paint/PreviewSurface.outputs:surface>

