        def Scope "Colliders"
        {
            def Cube "Cap" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </BenchPSU/Looks/Phys_ABS_Button> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                custom float physxCollision:contactOffset = 0.0005
                custom float physxCollision:restOffset = 0
                uniform token purpose = "guide"
                double size = 1
                float3 xformOp:scale = (0.014, 0.008, 0.014)
                double3 xformOp:translate = (0, -0.004, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
        }
    }

