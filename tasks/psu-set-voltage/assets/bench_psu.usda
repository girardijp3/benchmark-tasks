            prepend apiSchemas = ["PhysicsDriveAPI:linear"]
            doc = "Latching push button: 0 = out, + = pressed in (4.5 mm stop). Return spring 400 N/m with 0.8 N preload (target -2 mm). A task moves the target to +2.5 mm while latched on."
