#usda 1.0
(
    defaultPrim = "Residue"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Residue" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsArticulationRootAPI"]
    doc = "A declared material-removal layer: 128 cells of 5 mm on the pan's 80 x 40 mm patch, each a 4.8 x 4.8 x 0.05 mm pale film on a slide.  The free root follows the pan; a clean cell slides 0.3 mm down into the base and disappears.  Visual only, no collider."
)
{
    point3f physics:centerOfMass = (0, 0, 0)
    float3 physics:diagonalInertia = (1e-7, 1e-7, 1e-7)
    float physics:mass = 0.001
    custom bool physxRigidBody:disableGravity = 1

    def Scope "Looks"
    {
        def Material "mc888681"
        {
            token outputs:surface.connect = </Residue/Looks/mc888681/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.895, 0.875, 0.82)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }
    }

    def Xform "C0" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (0, 0, 0)
        float3 physics:diagonalInertia = (1e-12, 1e-12, 1e-12)
        float physics:mass = 0.000001
        custom bool physxRigidBody:disableGravity = 1
        double3 xformOp:translate = (-0.0175, -0.0375, 0.00004)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "Cell1" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Residue/Looks/mc888681>
            double size = 1
            float3 xformOp:scale = (0.0048, 0.0048, 0.00005)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Scope "Joints"
    {
        def PhysicsPrismaticJoint "C0" (
            prepend apiSchemas = ["PhysicsDriveAPI:linear"]
        )
        {
            float drive:linear:physics:damping = 2
            float drive:linear:physics:stiffness = 80
            float drive:linear:physics:targetPosition = 0
            uniform token drive:linear:physics:type = "force"
            uniform token physics:axis = "Z"
            rel physics:body0 = </Residue>
            rel physics:body1 = </Residue/C0>
            point3f physics:localPos0 = (-0.0175, -0.0375, 0.00004)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -0.0003
            float physics:upperLimit = 0
        }

