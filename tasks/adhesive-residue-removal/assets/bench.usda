#usda 1.0
(
    defaultPrim = "Bench"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Bench" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    doc = "The returns bench fixtures: a 350 x 350 x 3 mm high-friction silicone mat, a 300 x 200 x 20 mm tool/pad tray, a 150 x 100 x 20 mm waste tray with the peeled Avery label, three opened Chempad foil packets, a 5 mm grid overlay, a 10x loupe and a 30-degree raking LED.  Origin: table top, x/y world."
)
{
    point3f physics:centerOfMass = (0, 0, 0.02)
    float3 physics:diagonalInertia = (1, 1, 1)
    float physics:mass = 1

    def Scope "Looks"
    {
        def Material "Phys_mat" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 1
            float physics:restitution = 0
            float physics:staticFriction = 1.2
        }

        def Material "Phys_tray" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.6
            float physics:restitution = 0
            float physics:staticFriction = 0.7
        }

        def Material "mc080910"
        {
            token outputs:surface.connect = </Bench/Looks/mc080910/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.09, 0.095, 0.105)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "mc556167"
