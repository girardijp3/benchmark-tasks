#usda 1.0
(
    defaultPrim = "PadHolder"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "PadHolder" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    doc = "Bench pad applicator: a 76 x 102 x 3 mm Chemtronics Chempad on an 80 x 106 x 4 mm backing foot with a 30 x 18 x 30 mm vertical grip bar.  The white pad is the contact face.  Origin: the middle of the pad's contact face."
)
{
    point3f physics:centerOfMass = (0, 0, 0.012)
    float3 physics:diagonalInertia = (0.000052, 0.000042, 0.000031)
    float physics:mass = 0.045

    def Scope "Looks"
    {
        def Material "Phys_felt" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.45
            float physics:restitution = 0
            float physics:staticFriction = 0.55
            custom float physxMaterial:compliantContactDamping = 30
            custom float physxMaterial:compliantContactStiffness = 900
        }

        def Material "Phys_plastic" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.5
            float physics:restitution = 0
            float physics:staticFriction = 0.6
        }

        def Material "mc949492"
        {
            token outputs:surface.connect = </PadHolder/Looks/mc949492/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.955, 0.95, 0.93)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "mc194677"
        {
            token outputs:surface.connect = </PadHolder/Looks/mc194677/PreviewSurface.outputs:surface>

