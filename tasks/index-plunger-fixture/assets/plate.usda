#usda 1.0
(
    defaultPrim = "Plate"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Plate" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    doc = "rotary 8-stop index plate with central hub and rim holes"
)
{
    point3f physics:centerOfMass = (0, 0, 0)
    float3 physics:diagonalInertia = (0.000001, 0.000001, 0.000001)
    float physics:mass = 0.6
    custom bool physxRigidBody:disableGravity = 1

    def Scope "Looks"
    {
        def Material "m596265_43"
        {
            token outputs:surface.connect = </Plate/Looks/m596265_43/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.6, 0.63, 0.66)
                float inputs:metallic = 0.5
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

