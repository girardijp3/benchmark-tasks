#usda 1.0
(
    defaultPrim = "TagHolder"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "TagHolder" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    doc = "A tag holder bolted to the table: a 100 x 28 mm base with a slot 8 mm wide, 90 mm long, 24 mm deep (flared to 20 mm at the top), open to the sides at its ends by 5 mm end stops. The red tag (5 mm thick) stands in it. Origin on the table at the slot's centre; slot long side along x."
)
{
    point3f physics:centerOfMass = (0, 0, 0)
    float3 physics:diagonalInertia = (0.001, 0.001, 0.001)
    float physics:mass = 0.5

    def Scope "Looks"
    {
        def Material "Phys_plastic" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.35
            float physics:restitution = 0
            float physics:staticFriction = 0.45
        }

        def Material "m171954"
        {
            token outputs:surface.connect = </TagHolder/Looks/m171954/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.18, 0.2, 0.55)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }
    }

    def Cube "Box1" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </TagHolder/Looks/m171954>
        rel material:binding:physics = </TagHolder/Looks/Phys_plastic> (
            bindMaterialAs = "weakerThanDescendants"
        )
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.1, 0.028, 0.006)
        double3 xformOp:translate = (0, 0, 0.003)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Mesh "Wall2" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI", "MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-0.05, -0.014, 0.006), (0.05, -0.004, 0.03)]
        int[] faceVertexCounts = [3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3]
        int[] faceVertexIndices = [0, 2, 1, 5, 6, 7, 0, 3, 2, 5, 7, 8, 0, 4, 3, 5, 8, 9, 0, 1, 6, 0, 6, 5, 1, 2, 7, 1, 7, 6, 2, 3, 8, 2, 8, 7, 3, 4, 9, 3, 9, 8, 4, 0, 5, 4, 5, 9]
        rel material:binding = </TagHolder/Looks/m171954>
        rel material:binding:physics = </TagHolder/Looks/Phys_plastic> (
            bindMaterialAs = "weakerThanDescendants"
        )
        uniform token physics:approximation = "convexHull"
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        point3f[] points = [(-0.05, -0.004, 0.022), (-0.05, -0.01, 0.03), (-0.05, -0.014, 0.03), (-0.05, -0.014, 0.006), (-0.05, -0.004, 0.006), (0.05, -0.004, 0.022), (0.05, -0.01, 0.03), (0.05, -0.014, 0.03), (0.05, -0.014, 0.006), (0.05, -0.004, 0.006)]
        uniform token subdivisionScheme = "none"
    }

    def Mesh "Wall3" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI", "MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-0.05, 0.004, 0.006), (0.05, 0.014, 0.03)]
        int[] faceVertexCounts = [3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3]
        int[] faceVertexIndices = [0, 2, 1, 5, 6, 7, 0, 3, 2, 5, 7, 8, 0, 4, 3, 5, 8, 9, 0, 1, 6, 0, 6, 5, 1, 2, 7, 1, 7, 6, 2, 3, 8, 2, 8, 7, 3, 4, 9, 3, 9, 8, 4, 0, 5, 4, 5, 9]
        rel material:binding = </TagHolder/Looks/m171954>
        rel material:binding:physics = </TagHolder/Looks/Phys_plastic> (
            bindMaterialAs = "weakerThanDescendants"
        )
        uniform token physics:approximation = "convexHull"
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        point3f[] points = [(-0.05, 0.004, 0.006), (-0.05, 0.014, 0.006), (-0.05, 0.014, 0.03), (-0.05, 0.01, 0.03), (-0.05, 0.004, 0.022), (0.05, 0.004, 0.006), (0.05, 0.014, 0.006), (0.05, 0.014, 0.03), (0.05, 0.01, 0.03), (0.05, 0.004, 0.022)]
        uniform token subdivisionScheme = "none"
    }

    def Cube "Box4" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </TagHolder/Looks/m171954>
        rel material:binding:physics = </TagHolder/Looks/Phys_plastic> (
            bindMaterialAs = "weakerThanDescendants"
        )
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.005, 0.028, 0.024)
        double3 xformOp:translate = (-0.0475, 0, 0.018)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Box5" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </TagHolder/Looks/m171954>
        rel material:binding:physics = </TagHolder/Looks/Phys_plastic> (
            bindMaterialAs = "weakerThanDescendants"
        )
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.005, 0.028, 0.024)
        double3 xformOp:translate = (0.0475, 0, 0.018)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}

