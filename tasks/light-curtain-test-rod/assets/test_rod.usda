#usda 1.0
(
    defaultPrim = "TestRod"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "TestRod" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    doc = "A 30 mm test rod, 300 mm long: a hollow aluminium tube, 1.5 mm wall, 110 g, yellow and black bands, a black grip band in the middle (where the centre of mass is). Origin at the middle; axis along x."
)
{
    point3f physics:centerOfMass = (0, 0, 0)
    float3 physics:diagonalInertia = (0.00002475, 0.000837375, 0.000837375)
    float physics:mass = 0.11

    def Scope "Looks"
    {
        def Material "Phys_alu" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.4
            float physics:restitution = 0
            float physics:staticFriction = 0.5
        }

        def Material "m957904"
        {
            token outputs:surface.connect = </TestRod/Looks/m957904/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.96, 0.8, 0.05)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "m040405"
        {
            token outputs:surface.connect = </TestRod/Looks/m040405/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.05, 0.05, 0.06)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }
    }

    def Cylinder "Cyl1" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        uniform token axis = "X"
        double height = 0.3
        rel material:binding:physics = </TestRod/Looks/Phys_alu> (
            bindMaterialAs = "weakerThanDescendants"
        )
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        uniform token purpose = "guide"
        double radius = 0.015
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "Cyl2" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "X"
        double height = 0.05
        rel material:binding = </TestRod/Looks/m957904>
        double radius = 0.015
        double3 xformOp:translate = (-0.125, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "Cyl3" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "X"
        double height = 0.05
        rel material:binding = </TestRod/Looks/m040405>
        double radius = 0.015
        double3 xformOp:translate = (-0.07499999999999998, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "Cyl4" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "X"
        double height = 0.05
        rel material:binding = </TestRod/Looks/m040405>
        double radius = 0.015
        double3 xformOp:translate = (-0.024999999999999994, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "Cyl5" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "X"
        double height = 0.05
        rel material:binding = </TestRod/Looks/m040405>
        double radius = 0.015
        double3 xformOp:translate = (0.025000000000000022, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "Cyl6" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "X"
        double height = 0.05
        rel material:binding = </TestRod/Looks/m957904>
        double radius = 0.015
        double3 xformOp:translate = (0.07500000000000001, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "Cyl7" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "X"
        double height = 0.05
        rel material:binding = </TestRod/Looks/m040405>
        double radius = 0.015
        double3 xformOp:translate = (0.12500000000000003, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}

