#usda 1.0
(
    defaultPrim = "PeanForceps"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "PeanForceps" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    doc = "Rochester-Pean forceps, straight, 6.25 in (160 mm), closed on the ratchet. Origin at the centre of mass on the underside; +x toward the tip."
)
{
    float physics:mass = 0.06

    def Scope "Looks"
    {
        def Material "Steel"
        {
            token outputs:surface.connect = </PeanForceps/Looks/Steel/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.81, 0.83)
                float inputs:metallic = 0.9
                float inputs:roughness = 0.28
                token outputs:surface
            }
        }

        def Material "Phys_Steel" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.4
            float physics:restitution = 0
            float physics:staticFriction = 0.5
        }

        def Material "Screw"
        {
            token outputs:surface.connect = </PeanForceps/Looks/Screw/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.36, 0.37, 0.4)
                float inputs:metallic = 0.8
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "Mark"
        {
            token outputs:surface.connect = </PeanForceps/Looks/Mark/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.07, 0.07, 0.08)
                float inputs:metallic = 0
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }
    }

