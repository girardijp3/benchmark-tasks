#usda 1.0
(
    defaultPrim = "NeedleHolder"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "NeedleHolder" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    doc = "Mayo-Hegar needle holder, 6 in (152 mm), closed on the ratchet, gold rings, short stout jaws. Origin at the centre of mass on the underside; +x toward the jaws."
)
{
    float physics:mass = 0.07

    def Scope "Looks"
    {
        def Material "Gold"
        {
            token outputs:surface.connect = </NeedleHolder/Looks/Gold/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.88, 0.66, 0.2)
                float inputs:metallic = 0.9
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "Phys_Steel" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.4
            float physics:restitution = 0
            float physics:staticFriction = 0.5
        }

        def Material "Steel"
        {
            token outputs:surface.connect = </NeedleHolder/Looks/Steel/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.81, 0.83)
                float inputs:metallic = 0.9
                float inputs:roughness = 0.28
                token outputs:surface
            }
        }

        def Material "Screw"
        {
            token outputs:surface.connect = </NeedleHolder/Looks/Screw/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.36, 0.37, 0.4)
                float inputs:metallic = 0.8
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "Mark"
        {
            token outputs:surface.connect = </NeedleHolder/Looks/Mark/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.07, 0.07, 0.08)
                float inputs:metallic = 0
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }
    }

