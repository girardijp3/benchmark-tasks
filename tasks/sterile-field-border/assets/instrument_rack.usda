#usda 1.0
(
    defaultPrim = "InstrumentRack"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "InstrumentRack" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI"]
    doc = "Instrument rack: a stainless tray 250 x 200 x 4 mm with eight silicone rests (12 x 26 x 8 mm) that hold four instruments lying flat, 8 mm above the tray. Origin at the centre of its underside."
)
{
    bool physics:kinematicEnabled = 1

    def Scope "Looks"
    {
        def Material "Phys_Rack" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.4
            float physics:restitution = 0
            float physics:staticFriction = 0.5
        }

        def Material "Rack"
        {
            token outputs:surface.connect = </InstrumentRack/Looks/Rack/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.62, 0.64, 0.67)
                float inputs:metallic = 0.8
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "Post"
        {
            token outputs:surface.connect = </InstrumentRack/Looks/Post/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.12, 0.45, 0.55)
                float inputs:metallic = 0
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }

        def Material "Phys_Silicone" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.7
            float physics:restitution = 0
            float physics:staticFriction = 0.8
        }
    }

