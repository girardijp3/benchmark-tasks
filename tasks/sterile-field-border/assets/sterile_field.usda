            int[] faceVertexCounts = [3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3]
            int[] faceVertexIndices = [0, 2, 1, 4, 5, 6, 0, 3, 2, 4, 6, 7, 0, 1, 5, 0, 5, 4, 1, 2, 6, 1, 6, 5, 2, 3, 7, 2, 7, 6, 3, 0, 4, 3, 4, 7]
            rel material:binding = </SterileField/Looks/Field>
            point3f[] points = [(-0.1246, -0.1946, 0), (0.1246, -0.1946, 0), (0.1246, 0.1946, 0), (-0.1246, 0.1946, 0), (-0.1246, -0.1946, 0.003), (0.1246, -0.1946, 0.003), (0.1246, 0.1946, 0.003), (-0.1246, 0.1946, 0.003)]
            uniform token subdivisionScheme = "none"
