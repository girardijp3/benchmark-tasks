    def Scope "Colliders"
    {
        def Mesh "Panel" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
        )
        {
            float3[] extent = [(-0.15, -0.22, 0), (0.15, 0.22, 0.003)]
            int[] faceVertexCounts = [3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3]
            int[] faceVertexIndices = [0, 2, 1, 4, 5, 6, 0, 3, 2, 4, 6, 7, 0, 1, 5, 0, 5, 4, 1, 2, 6, 1, 6, 5, 2, 3, 7, 2, 7, 6, 3, 0, 4, 3, 4, 7]
            rel material:binding:physics = </SterileField/Looks/Phys_Drape> (
                bindMaterialAs = "weakerThanDescendants"
            )
            uniform token physics:approximation = "convexHull"
            custom float physxCollision:contactOffset = 0.0008
            custom float physxCollision:restOffset = 0
            point3f[] points = [(-0.15, -0.22, 0), (0.15, -0.22, 0), (0.15, 0.22, 0), (-0.15, 0.22, 0), (-0.15, -0.22, 0.003), (0.15, -0.22, 0.003), (0.15, 0.22, 0.003), (-0.15, 0.22, 0.003)]
