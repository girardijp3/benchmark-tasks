#usda 1.0
(
    defaultPrim = "SterileField"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "SterileField" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI"]
    doc = "Sterile field: a flat rigid panel 300 x 440 mm, 3 mm thick, standing in for the cloth drape; the unsterile border (25.4 mm, 1 inch) is drawn on it in orange. Origin at the centre of its underside."
)
{
    bool physics:kinematicEnabled = 1

    def Scope "Looks"
    {
        def Material "Phys_Drape" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.4
            float physics:restitution = 0
            float physics:staticFriction = 0.5
        }

        def Material "Field"
        {
            token outputs:surface.connect = </SterileField/Looks/Field/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.42, 0.74)
                float inputs:metallic = 0
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }

        def Material "Band"
        {
            token outputs:surface.connect = </SterileField/Looks/Band/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.93, 0.5, 0.12)
                float inputs:metallic = 0
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }

        def Material "Line"
        {
            token outputs:surface.connect = </SterileField/Looks/Line/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.97, 0.97, 0.97)
                float inputs:metallic = 0
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }
    }

    def Scope "Visuals"
    {
        def Mesh "Inner" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
