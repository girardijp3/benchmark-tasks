#usda 1.0
(
    defaultPrim = "ScalpelHandle"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "ScalpelHandle" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    doc = "Scalpel handle no. 4, 135 mm, no blade fitted, with centimetre marks. Origin at the centre of mass on the underside; +x toward the blade end."
)
{
    float physics:mass = 0.022

    def Scope "Looks"
    {
        def Material "Steel"
        {
            token outputs:surface.connect = </ScalpelHandle/Looks/Steel/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.81, 0.83)
                float inputs:metallic = 0.9
                float inputs:roughness = 0.28
                token outputs:surface
            }
        }

        def Material "Phys_Steel" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.4
            float physics:restitution = 0
            float physics:staticFriction = 0.5
        }

        def Material "Dark"
        {
            token outputs:surface.connect = </ScalpelHandle/Looks/Dark/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.16, 0.16, 0.18)
                float inputs:metallic = 0.2
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "Mark"
        {
            token outputs:surface.connect = </ScalpelHandle/Looks/Mark/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.07, 0.07, 0.08)
                float inputs:metallic = 0
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }
    }

