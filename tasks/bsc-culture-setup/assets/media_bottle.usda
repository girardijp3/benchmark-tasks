#usda 1.0
(
    defaultPrim = "MediaBottle"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "MediaBottle" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    doc = "250 mL cell-culture media bottle: 70 mm across, 140 mm tall with cap, 0.30 kg full. Origin: middle of the base."
)
{
    float physics:mass = 0.3
    custom float physxRigidBody:maxDepenetrationVelocity = 0.2
    custom int physxRigidBody:solverPositionIterationCount = 32
    custom int physxRigidBody:solverVelocityIterationCount = 4

    def Scope "Looks"
    {
        def Material "Phys" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.5
            float physics:restitution = 0
            float physics:staticFriction = 0.6
        }

        def Material "Glass"
        {
            token outputs:surface.connect = </MediaBottle/Looks/Glass/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.9, 0.92)
                float inputs:metallic = 0
                float inputs:roughness = 0.2
                token outputs:surface
            }
        }

        def Material "Medium"
        {
            token outputs:surface.connect = </MediaBottle/Looks/Medium/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.85, 0.25, 0.3)
                float inputs:metallic = 0
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "Cap"
        {
            token outputs:surface.connect = </MediaBottle/Looks/Cap/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.3, 0.75)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
    }

