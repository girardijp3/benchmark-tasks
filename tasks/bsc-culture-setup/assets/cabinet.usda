#usda 1.0
(
    defaultPrim = "Cabinet"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Cabinet" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    doc = "Class II biosafety cabinet work zone: front grille (x 0.25-0.35), rear grille (x 0.50-0.55), sash raised to a 380 mm opening (loading position), back wall. Fixed. Origin: on the table at x 0.0, y 0."
)
{
    bool physics:kinematicEnabled = 1
    float physics:mass = 20
    custom float physxRigidBody:maxDepenetrationVelocity = 0.2
    custom int physxRigidBody:solverPositionIterationCount = 32
    custom int physxRigidBody:solverVelocityIterationCount = 4

    def Scope "Looks"
    {
        def Material "Phys" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.4
            float physics:restitution = 0
            float physics:staticFriction = 0.5
        }

        def Material "Mat"
        {
            token outputs:surface.connect = </Cabinet/Looks/Mat/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.82, 0.84)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "Grille"
        {
            token outputs:surface.connect = </Cabinet/Looks/Grille/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.25, 0.27, 0.3)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "Slot"
        {
            token outputs:surface.connect = </Cabinet/Looks/Slot/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.05, 0.05, 0.06)
                float inputs:metallic = 0
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }

        def Material "Glass"
        {
            token outputs:surface.connect = </Cabinet/Looks/Glass/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.75, 0.85)
                float inputs:metallic = 0
                float inputs:roughness = 0.2
                token outputs:surface
            }
        }
    }

    def Xform "Visual"
