#usda 1.0
(
    defaultPrim = "TipBox"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "TipBox" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    doc = "Pipette tip box (typical 200 uL rack, closed): 127 x 83 x 55 mm, 0.12 kg. Origin: middle of the base."
)
{
    float physics:mass = 0.12
    custom float physxRigidBody:maxDepenetrationVelocity = 0.2
    custom int physxRigidBody:solverPositionIterationCount = 32
    custom int physxRigidBody:solverVelocityIterationCount = 4

    def Scope "Looks"
    {
        def Material "Phys" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.5
            float physics:restitution = 0
            float physics:staticFriction = 0.6
        }

        def Material "Base"
        {
            token outputs:surface.connect = </TipBox/Looks/Base/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.15, 0.4, 0.8)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "Lid"
        {
            token outputs:surface.connect = </TipBox/Looks/Lid/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9, 0.93, 0.95)
                float inputs:metallic = 0
                float inputs:roughness = 0.2
                token outputs:surface
            }
        }
    }

    def Xform "Visual"
    {
        def Mesh "Base" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            float3[] extent = [(-0.0625, -0.0405, 0), (0.0625, 0.0405, 0.03)]
            int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
            int[] faceVertexIndices = [0, 1, 3, 2, 4, 6, 7, 5, 0, 4, 5, 1, 2, 3, 7, 6, 0, 2, 6, 4, 1, 5, 7, 3]
            rel material:binding = </TipBox/Looks/Base>
            point3f[] points = [(-0.0625, -0.0405, 0), (-0.0625, -0.0405, 0.03), (-0.0625, 0.0405, 0), (-0.0625, 0.0405, 0.03), (0.0625, -0.0405, 0), (0.0625, -0.0405, 0.03), (0.0625, 0.0405, 0), (0.0625, 0.0405, 0.03)]
            uniform token subdivisionScheme = "none"
        }

        def Mesh "Lid" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            float3[] extent = [(-0.0635, -0.0415, 0.03), (0.0635, 0.0415, 0.055)]
            int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
            int[] faceVertexIndices = [0, 1, 3, 2, 4, 6, 7, 5, 0, 4, 5, 1, 2, 3, 7, 6, 0, 2, 6, 4, 1, 5, 7, 3]
            rel material:binding = </TipBox/Looks/Lid>
            point3f[] points = [(-0.0635, -0.0415, 0.03), (-0.0635, -0.0415, 0.055), (-0.0635, 0.0415, 0.03), (-0.0635, 0.0415, 0.055), (0.0635, -0.0415, 0.03), (0.0635, -0.0415, 0.055), (0.0635, 0.0415, 0.03), (0.0635, 0.0415, 0.055)]
            uniform token subdivisionScheme = "none"
        }
    }

    def Xform "Colliders"
    {
        def Cube "All" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </TipBox/Looks/Phys> (
                bindMaterialAs = "weakerThanDescendants"
            )
            custom float physxCollision:contactOffset = 0.0003
            custom float physxCollision:restOffset = 0
            uniform token purpose = "guide"
            double size = 1
            float3 xformOp:scale = (0.127, 0.083, 0.055)
            double3 xformOp:translate = (0, 0, 0.0275)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }
}

