#usda 1.0
(
    defaultPrim = "ReamerRest"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "ReamerRest" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    doc = "A fixed rest for the reamer: a 90 x 90 x 6 mm plate with an 18 mm bore through an 18 mm wall (5 mm lead-in); the cone stands in it. Origin: table level at the bore's axis."
)
{
    point3f physics:centerOfMass = (0, 0, 0.009)
    float3 physics:diagonalInertia = (0.001, 0.001, 0.001)
    float physics:mass = 0.4

    def Scope "Looks"
    {
        def Material "Phys_plastic" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.4
            float physics:restitution = 0
            float physics:staticFriction = 0.45
        }

        def Material "v293032_3_8"
        {
            token outputs:surface.connect = </ReamerRest/Looks/v293032_3_8/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.3, 0.31, 0.33)
                float inputs:metallic = 0.85
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "v050506_5_2"
        {
            token outputs:surface.connect = </ReamerRest/Looks/v050506_5_2/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.06, 0.06, 0.07)
                float inputs:metallic = 0.2
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "v845409_4_5"
        {
            token outputs:surface.connect = </ReamerRest/Looks/v845409_4_5/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.85, 0.55, 0.1)
                float inputs:metallic = 0.5
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }
    }

    def Cube "Plate1" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </ReamerRest/Looks/Phys_plastic> (
            bindMaterialAs = "weakerThanDescendants"
        )
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        uniform token purpose = "guide"
        double size = 1
        float3 xformOp:scale = (0.09, 0.09, 0.006)
        double3 xformOp:translate = (0, 0, 0.003)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

