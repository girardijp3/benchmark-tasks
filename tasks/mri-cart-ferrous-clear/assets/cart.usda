#usda 1.0
(
    defaultPrim = "cart"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "cart" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    doc = "Compact two-shelf rolling tray cart, tray 460 x 360 mm, upper face 120 mm above the table (casters locked, so it is a fixture). Origin at the middle of the footprint on the table, x along the 460 mm side."
)
{
    bool physics:kinematicEnabled = 1
    float physics:mass = 4

    def Scope "Looks"
    {
        def Material "Tray"
        {
            token outputs:surface.connect = </cart/Looks/Tray/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.82, 0.84)
                float inputs:metallic = 1
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "Phys_Tray" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.35
            float physics:restitution = 0
            float physics:staticFriction = 0.4
        }

        def Material "Frame"
        {
            token outputs:surface.connect = </cart/Looks/Frame/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.57, 0.6)
                float inputs:metallic = 1
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "Rubber"
        {
            token outputs:surface.connect = </cart/Looks/Rubber/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.04, 0.04, 0.045)
                float inputs:metallic = 0
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }
    }

    def Cube "Tray" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </cart/Looks/Tray>
        double size = 1
        float3 xformOp:scale = (0.46, 0.36, 0.003)
        double3 xformOp:translate = (0, 0, 0.1185)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Tray_C" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </cart/Looks/Phys_Tray> (
            bindMaterialAs = "weakerThanDescendants"
        )
        uniform token purpose = "guide"
        double size = 1
        float3 xformOp:scale = (0.46, 0.36, 0.003)
        double3 xformOp:translate = (0, 0, 0.1185)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Rim0" (
