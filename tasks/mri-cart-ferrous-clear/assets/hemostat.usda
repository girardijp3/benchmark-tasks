def Xform "hemostat" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    doc = "Kelly hemostat (locking forceps), 5.5 in (140 mm), martensitic stainless steel (magnetic), 52 g, closed and lying flat. Origin at the box lock; x toward the jaw tips (55 mm), the finger rings 85 mm behind."
)
{
    float physics:mass = 0.052

    def Scope "Looks"
    {
        def Material "Steel"
        {
            token outputs:surface.connect = </hemostat/Looks/Steel/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.74, 0.76, 0.79)
                float inputs:metallic = 1
                float inputs:roughness = 0.28
                token outputs:surface
            }
        }

        def Material "Phys_Steel" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.35
            float physics:restitution = 0
            float physics:staticFriction = 0.45
        }

        def Material "Groove"
        {
            token outputs:surface.connect = </hemostat/Looks/Groove/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.35, 0.37, 0.4)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
    }

