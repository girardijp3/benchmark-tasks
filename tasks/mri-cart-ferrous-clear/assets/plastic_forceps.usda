    float physics:mass = 0.012

    def Scope "Looks"
    {
        def Material "BluePlastic"
        {
            token outputs:surface.connect = </plastic_forceps/Looks/BluePlastic/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.38, 0.85)
                float inputs:metallic = 0
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "Phys_Plastic" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.38
            float physics:restitution = 0
            float physics:staticFriction = 0.45
        }

        def Material "Groove"
        {
            token outputs:surface.connect = </plastic_forceps/Looks/Groove/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.05, 0.25, 0.65)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
    }

