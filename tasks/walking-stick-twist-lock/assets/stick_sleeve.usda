#usda 1.0
(
    defaultPrim = "Sleeve"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Sleeve" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    doc = "The sleeve of an adjustable walking stick in its stand: a 32 mm aluminium ring (bore 24 mm) 100 mm tall on a base plate, with two axial slots and two circumferential notches (stowed, and at the red mark). Fixed. Origin: table level, the axis."
)
{
    point3f physics:centerOfMass = (0, 0, 0.03)
    float3 physics:diagonalInertia = (0.001, 0.001, 0.001)
    float physics:mass = 1

    def Scope "Looks"
    {
        def Material "Phys_al" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.3
            float physics:restitution = 0
            float physics:staticFriction = 0.35
        }

        def Material "m717377"
        {
            token outputs:surface.connect = </Sleeve/Looks/m717377/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.72, 0.74, 0.78)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }
    }

    def Cylinder "Base1" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.006
        rel material:binding = </Sleeve/Looks/m717377>
        rel material:binding:physics = </Sleeve/Looks/Phys_al> (
            bindMaterialAs = "weakerThanDescendants"
        )
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        double radius = 0.03
        double3 xformOp:translate = (0, 0, 0.003)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

