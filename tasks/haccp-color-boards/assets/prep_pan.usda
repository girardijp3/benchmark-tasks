#usda 1.0
(
    defaultPrim = "PrepPan"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "PrepPan" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    doc = "Stainless gastronorm 1/2 pan, 265 x 325 x 20 mm, 1.5 mm sheet, for the raw cuts. Origin at the underside's centre, x across the 265 mm side. Spawned kinematic."
)
{
    bool physics:kinematicEnabled = 1
    float physics:mass = 0.6

    def "Looks"
    {
        def Material "Phys_Steel" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.3
            float physics:restitution = 0
            float physics:staticFriction = 0.4
        }

        def Material "Steel"
        {
            token outputs:surface.connect = </PrepPan/Looks/Steel/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.72, 0.73, 0.75)
                float inputs:metallic = 0.9
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }
    }

    def Cube "Floor" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </PrepPan/Looks/Phys_Steel> (
            bindMaterialAs = "weakerThanDescendants"
        )
        uniform token purpose = "guide"
        double size = 1
        float3 xformOp:scale = (0.265, 0.325, 0.0015)
        double3 xformOp:translate = (0, 0, 0.00075)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Mesh "FloorV" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-0.1325, -0.1625, 0), (0.1325, 0.1625, 0.0015)]
        int[] faceVertexCounts = [3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3]
        int[] faceVertexIndices = [0, 1, 3, 0, 3, 2, 4, 6, 7, 4, 7, 5, 0, 4, 5, 0, 5, 1, 2, 3, 7, 2, 7, 6, 0, 2, 6, 0, 6, 4, 1, 5, 7, 1, 7, 3]
        rel material:binding = </PrepPan/Looks/Steel>
        point3f[] points = [(-0.1325, -0.1625, 0), (-0.1325, -0.1625, 0.0015), (-0.1325, 0.1625, 0), (-0.1325, 0.1625, 0.0015), (0.1325, -0.1625, 0), (0.1325, -0.1625, 0.0015), (0.1325, 0.1625, 0), (0.1325, 0.1625, 0.0015)]
        uniform token subdivisionScheme = "none"
    }

    def Cube "Wall0" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </PrepPan/Looks/Phys_Steel> (
            bindMaterialAs = "weakerThanDescendants"
        )
        uniform token purpose = "guide"
        double size = 1
        float3 xformOp:scale = (0.0015, 0.325, 0.02)
        double3 xformOp:translate = (0.13175, 0, 0.01)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Mesh "WallV0" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        float3[] extent = [(0.131, -0.1625, 0), (0.1325, 0.1625, 0.02)]
        int[] faceVertexCounts = [3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3]
        int[] faceVertexIndices = [0, 1, 3, 0, 3, 2, 4, 6, 7, 4, 7, 5, 0, 4, 5, 0, 5, 1, 2, 3, 7, 2, 7, 6, 0, 2, 6, 0, 6, 4, 1, 5, 7, 1, 7, 3]
        rel material:binding = </PrepPan/Looks/Steel>
        point3f[] points = [(0.131, -0.1625, 0), (0.131, -0.1625, 0.02), (0.131, 0.1625, 0), (0.131, 0.1625, 0.02), (0.1325, -0.1625, 0), (0.1325, -0.1625, 0.02), (0.1325, 0.1625, 0), (0.1325, 0.1625, 0.02)]
        uniform token subdivisionScheme = "none"
    }

    def Cube "Wall1" (
