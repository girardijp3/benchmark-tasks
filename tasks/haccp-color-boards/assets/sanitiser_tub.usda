    )
    {
        float3[] extent = [(-0.072, -0.1, 0), (0.072, -0.097, 0.07)]
        int[] faceVertexCounts = [3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3]
        int[] faceVertexIndices = [0, 1, 3, 0, 3, 2, 4, 6, 7, 4, 7, 5, 0, 4, 5, 0, 5, 1, 2, 3, 7, 2, 7, 6, 0, 2, 6, 0, 6, 4, 1, 5, 7, 1, 7, 3]
        rel material:binding = </SanitiserTub/Looks/Shell>
        point3f[] points = [(-0.072, -0.1, 0), (-0.072, -0.1, 0.07), (-0.072, -0.097, 0), (-0.072, -0.097, 0.07), (0.072, -0.1, 0), (0.072, -0.1, 0.07), (0.072, -0.097, 0), (0.072, -0.097, 0.07)]
        uniform token subdivisionScheme = "none"
    }

    def Mesh "Solution" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-0.0719, -0.0969, 0.00225), (0.0719, 0.0969, 0.04075)]
        int[] faceVertexCounts = [3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3]
        int[] faceVertexIndices = [0, 1, 3, 0, 3, 2, 4, 6, 7, 4, 7, 5, 0, 4, 5, 0, 5, 1, 2, 3, 7, 2, 7, 6, 0, 2, 6, 0, 6, 4, 1, 5, 7, 1, 7, 3]
        rel material:binding = </SanitiserTub/Looks/Liquid>
        point3f[] points = [(-0.0719, -0.0969, 0.00225), (-0.0719, -0.0969, 0.04075), (-0.0719, 0.0969, 0.00225), (-0.0719, 0.0969, 0.04075), (0.0719, -0.0969, 0.00225), (0.0719, -0.0969, 0.04075), (0.0719, 0.0969, 0.00225), (0.0719, 0.0969, 0.04075)]
