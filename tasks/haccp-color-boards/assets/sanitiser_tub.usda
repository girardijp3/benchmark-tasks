        point3f[] points = [(-0.075, -0.1, 0), (-0.075, -0.1, 0.07), (-0.075, 0.1, 0), (-0.075, 0.1, 0.07), (-0.072, -0.1, 0), (-0.072, -0.1, 0.07), (-0.072, 0.1, 0), (-0.072, 0.1, 0.07)]
        uniform token subdivisionScheme = "none"
    }

    def Cube "Wall2" (
