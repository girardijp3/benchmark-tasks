    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    doc = "Raw boneless pork loin chop, rigid stand-in, about 112 x 70 x 22 mm, with a pale fat edge. Origin at the underside's centre (the planform's centroid), x along the cut's length. One rigid body; the collider is its convex hull (at most 64 vertices)."
