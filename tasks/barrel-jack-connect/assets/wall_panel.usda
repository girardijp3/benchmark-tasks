#usda 1.0
(
    defaultPrim = "WallPanel"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "WallPanel" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    doc = "The bench's back panel: a white-painted 18 mm board, 800 mm wide and 400 mm tall, standing on the bench's back edge (the task spawns it fixed). Frame: origin at the bottom of its front face, centre, +x out of the panel. The task adds the wall socket (a SimReady model) into it."
)
{
    float physics:mass = 4

    def Scope "Looks"
    {
        def Material "Paint_White"
        {
            token outputs:surface.connect = </WallPanel/Looks/Paint_White/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.8, 0.78)
                float inputs:metallic = 0
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }

        def Material "Phys_Paint" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.4
            float physics:restitution = 0
            float physics:staticFriction = 0.5
        }
    }

