#usda 1.0
(
    defaultPrim = "AdapterJackCable"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "AdapterJackCable" (
    doc = "A 12 V 1 A wall adapter (Europlug) whose 3.5 mm cord ends in a female 5.5 x 2.1 mm in-line barrel jack: one articulation, the adapter its root (fixed in the wall socket by the task), 28 cord links of 12.5 mm on bending joints, and the jack. Adapter frame: origin at its back face at the pins' height, +x out of the wall, z up; the cord leaves its bottom. Jack frame: origin at its mouth, +x out of the mouth. The jack's fit is made of exact primitives: twelve boxes form the 5.9 mm bore (0.2 mm a side around the 5.5 mm barrel) with a 45 deg x 0.6 mm lead-in, and three rounded bars with a compliant contact (5000 N/m) are the spring contacts that hold the barrel. The centre pin is visual only."
)
{
    def Scope "Looks"
    {
        def Material "PVC_Black"
        {
            token outputs:surface.connect = </AdapterJackCable/Looks/PVC_Black/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.018, 0.018, 0.02)
                float inputs:metallic = 0
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "Nickel"
        {
            token outputs:surface.connect = </AdapterJackCable/Looks/Nickel/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.79, 0.76)
                float inputs:metallic = 1
                float inputs:roughness = 0.22
                token outputs:surface
            }
        }

        def Material "Insulator_Black"
        {
            token outputs:surface.connect = </AdapterJackCable/Looks/Insulator_Black/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.03, 0.03, 0.03)
                float inputs:metallic = 0
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }

        def Material "ABS_Black"
        {
            token outputs:surface.connect = </AdapterJackCable/Looks/ABS_Black/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.03, 0.03, 0.032)
                float inputs:metallic = 0
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "Label_Adapter"
        {
            token outputs:surface.connect = </AdapterJackCable/Looks/Label_Adapter/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </AdapterJackCable/Looks/Label_Adapter/Texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }

            def Shader "stReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/adapter_label.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </AdapterJackCable/Looks/Label_Adapter/stReader.outputs:result>
                float3 outputs:rgb
            }
        }

        def Material "Pin_Brass"
        {
            token outputs:surface.connect = </AdapterJackCable/Looks/Pin_Brass/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.7, 0.45)
                float inputs:metallic = 1
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "LED_Green"
        {
            token outputs:surface.connect = </AdapterJackCable/Looks/LED_Green/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.9, 0.2)
                float inputs:metallic = 0
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "Phys_PVC" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.5
            float physics:restitution = 0
            float physics:staticFriction = 0.6
        }

        def Material "Phys_Nickel" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.2
            float physics:restitution = 0
            float physics:staticFriction = 0.25
        }

        def Material "Phys_Spring_Contact" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.35
            float physics:restitution = 0
            float physics:staticFriction = 0.4
            custom float physxMaterial:compliantContactDamping = 5
            custom float physxMaterial:compliantContactStiffness = 5000
        }

        def Material "Phys_ABS" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.35
            float physics:restitution = 0
            float physics:staticFriction = 0.4
        }
    }

