#usda 1.0
(
    defaultPrim = "DimmerPlugCable"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "DimmerPlugCable" (
    doc = "A single-colour LED strip dimmer (60 x 34 x 18 mm, 12-24 V) whose 3.5 mm input cord ends in a male 5.5 x 2.1 mm barrel plug (9.5 mm barrel): one articulation, the dimmer its root (stuck to the bench by its adhesive pad: fixed by the task), 23 cord links of 12.5 mm on bending joints, and the plug. Dimmer frame: origin at its bottom centre, +x toward the input cord. Plug frame: origin at the overmold's front face, +x toward the barrel's tip. The barrel collides as a 5.5 mm capsule with a ring of sixteen 0.5 mm capsules at its tip (a 0.5 mm rounded edge, like the real chamfer), exact primitives for the 0.2 mm fit; the overmold and strain relief are 16-sided hulls."
)
{
    def Scope "Looks"
    {
        def Material "PVC_Black"
        {
            token outputs:surface.connect = </DimmerPlugCable/Looks/PVC_Black/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.018, 0.018, 0.02)
                float inputs:metallic = 0
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "Nickel"
        {
            token outputs:surface.connect = </DimmerPlugCable/Looks/Nickel/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.79, 0.76)
                float inputs:metallic = 1
                float inputs:roughness = 0.22
                token outputs:surface
            }
        }

        def Material "Insulator_Black"
        {
            token outputs:surface.connect = </DimmerPlugCable/Looks/Insulator_Black/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.03, 0.03, 0.03)
                float inputs:metallic = 0
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }

        def Material "ABS_Black"
        {
            token outputs:surface.connect = </DimmerPlugCable/Looks/ABS_Black/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.03, 0.03, 0.032)
                float inputs:metallic = 0
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "Label_Dimmer"
        {
            token outputs:surface.connect = </DimmerPlugCable/Looks/Label_Dimmer/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </DimmerPlugCable/Looks/Label_Dimmer/Texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }

            def Shader "stReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/dimmer_label.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </DimmerPlugCable/Looks/Label_Dimmer/stReader.outputs:result>
                float3 outputs:rgb
            }
        }

        def Material "Knob_Silver"
        {
            token outputs:surface.connect = </DimmerPlugCable/Looks/Knob_Silver/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.62, 0.63, 0.65)
                float inputs:metallic = 0.9
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "LED_Green"
        {
            token outputs:surface.connect = </DimmerPlugCable/Looks/LED_Green/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.9, 0.2)
                float inputs:metallic = 0
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "Connector_White"
        {
            token outputs:surface.connect = </DimmerPlugCable/Looks/Connector_White/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.85, 0.84, 0.8)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "Phys_PVC" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.5
            float physics:restitution = 0
            float physics:staticFriction = 0.6
        }

        def Material "Phys_Nickel" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.2
            float physics:restitution = 0
            float physics:staticFriction = 0.25
        }

        def Material "Phys_Spring_Contact" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.35
            float physics:restitution = 0
            float physics:staticFriction = 0.4
            custom float physxMaterial:compliantContactDamping = 5
            custom float physxMaterial:compliantContactStiffness = 5000
        }

        def Material "Phys_ABS" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.35
            float physics:restitution = 0
            float physics:staticFriction = 0.4
        }
    }

