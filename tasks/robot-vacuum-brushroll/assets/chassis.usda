#usda 1.0
(
    defaultPrim = "Chassis"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Chassis" (
    doc = "A vacuum's brush bay: base plate, two end walls with U-slots (12 mm bearing slot at -y, 9.5 mm square drive socket at +y, stair lead-ins), a back wall and a sprung guard (revolute about y, 0 closed, 70 open). Origin: table level, the bay's middle."
)
{
    def Scope "Looks"
    {
        def Material "Phys_plastic" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.4
            float physics:restitution = 0
            float physics:staticFriction = 0.45
        }

        def Material "m777779"
        {
            token outputs:surface.connect = </Chassis/Looks/m777779/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.78, 0.78, 0.8)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "m741109"
        {
            token outputs:surface.connect = </Chassis/Looks/m741109/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.75, 0.12, 0.1)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "m292931"
        {
            token outputs:surface.connect = </Chassis/Looks/m292931/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.3, 0.3, 0.32)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }
    }

    def Xform "Base" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsArticulationRootAPI"]
    )
    {
        point3f physics:centerOfMass = (0, 0, 0.01)
        float3 physics:diagonalInertia = (0.01, 0.01, 0.01)
        float physics:mass = 3
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "Base1" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding = </Chassis/Looks/m777779>
            rel material:binding:physics = </Chassis/Looks/Phys_plastic> (
                bindMaterialAs = "weakerThanDescendants"
            )
            custom float physxCollision:contactOffset = 0.001
            custom float physxCollision:restOffset = 0
            double size = 1
            float3 xformOp:scale = (0.09, 0.244, 0.01)
            double3 xformOp:translate = (0, 0, 0.005)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

