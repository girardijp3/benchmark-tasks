#usda 1.0
(
    defaultPrim = "Roll"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Roll" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    doc = "A robot vacuum's brush roll, 0.10 kg: a 28 x 200 mm body, a round stub (11 mm across, 18 mm long) at the -y end and a square drive stub (8 x 8 mm, 18 mm long) at the +y end. Origin: the body's middle, axis along y."
)
{
    point3f physics:centerOfMass = (0, 0, 0)
    float3 physics:diagonalInertia = (0.00033823334, 0.0000098, 0.00033823334)
    float physics:mass = 0.1

    def Scope "Looks"
    {
        def Material "Phys_plastic" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.4
            float physics:restitution = 0
            float physics:staticFriction = 0.45
        }

        def Material "m141416"
        {
            token outputs:surface.connect = </Roll/Looks/m141416/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.15, 0.15, 0.17)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "Phys_steel" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.4
            float physics:restitution = 0
            float physics:staticFriction = 0.45
        }

        def Material "m797981"
        {
            token outputs:surface.connect = </Roll/Looks/m797981/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.8, 0.82)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "m792909"
        {
            token outputs:surface.connect = </Roll/Looks/m792909/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.3, 0.1)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }
    }

    def Cylinder "Body1" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        uniform token axis = "Y"
        double height = 0.2
        rel material:binding = </Roll/Looks/m141416>
        rel material:binding:physics = </Roll/Looks/Phys_plastic> (
            bindMaterialAs = "weakerThanDescendants"
        )
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        double radius = 0.014
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "RoundStub2" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        uniform token axis = "Y"
        double height = 0.018
        rel material:binding = </Roll/Looks/m797981>
        rel material:binding:physics = </Roll/Looks/Phys_steel> (
            bindMaterialAs = "weakerThanDescendants"
        )
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        double radius = 0.0055
        double3 xformOp:translate = (0, -0.109, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cube "SquareStub3" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </Roll/Looks/m792909>
        rel material:binding:physics = </Roll/Looks/Phys_steel> (
            bindMaterialAs = "weakerThanDescendants"
        )
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.008, 0.018, 0.008)
        double3 xformOp:translate = (0, 0.109, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}

