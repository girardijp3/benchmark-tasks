#usda 1.0
(
    defaultPrim = "Panel"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Panel" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI"]
    doc = "fixed trim panel with an 8 mm mounting hole, welded visual-only"
)
{
    bool physics:kinematicEnabled = 1

    def Scope "Looks"
    {
        def Material "m293235_05"
        {
            token outputs:surface.connect = </Panel/Looks/m293235_05/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.3, 0.33, 0.36)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "m030404_05"
