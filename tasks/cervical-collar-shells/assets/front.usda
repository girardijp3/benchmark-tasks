#usda 1.0
(
    defaultPrim = "FrontShell"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "FrontShell" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    doc = "rigid cervical collar FRONT shell (chin support), 0.14 kg"
)
{
    point3f physics:centerOfMass = (0, 0, 0)
    float3 physics:diagonalInertia = (0.000001, 0.000001, 0.000001)
    float physics:mass = 0.14
    custom bool physxRigidBody:disableGravity = 1

    def Scope "Looks"
    {
        def Material "m144477_04"
        {
            token outputs:surface.connect = </FrontShell/Looks/m144477_04/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.15, 0.45, 0.78)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "m918983_08"
