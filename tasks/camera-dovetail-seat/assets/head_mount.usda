#usda 1.0
(
    defaultPrim = "ROOT"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "ROOT" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    doc = "A robot head's camera mount: a plate with a male dovetail rail (14 mm wide at the plate, 23 mm at the top, 6 mm tall, 66 mm long) open at its front end and closed by a stop block at the other. Fixed to the table. Origin: the middle of the plate's top face under the rail's axis, 50 mm above the table, y toward the stop."
)
{
    bool physics:kinematicEnabled = true
    float physics:mass = 3.0

    def Scope "Looks"
    {
        def Material "Plate"
        {
            token outputs:surface.connect = </ROOT/Looks/Plate/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.2, 0.22, 0.26)
                float inputs:metallic = 0.3
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }
        def Material "Rail"
        {
            token outputs:surface.connect = </ROOT/Looks/Rail/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.72, 0.74, 0.77)
                float inputs:metallic = 0.8
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }
        def Material "Head"
        {
            token outputs:surface.connect = </ROOT/Looks/Head/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.11, 0.13)
                float inputs:metallic = 0
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }
        def Material "Stop"
        {
            token outputs:surface.connect = </ROOT/Looks/Stop/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.85, 0.35, 0.1)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
        def Material "Phys_Metal" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.3
            float physics:restitution = 0
            float physics:staticFriction = 0.4
        }
    }

    def Cube "Plate" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </ROOT/Looks/Plate>
        double size = 1
        double3 xformOp:translate = (0, -0.0215, -0.004)
        float3 xformOp:scale = (0.11, 0.147, 0.008)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cube "Head" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </ROOT/Looks/Head>
        double size = 1
        double3 xformOp:translate = (0, -0.01, -0.029)
        float3 xformOp:scale = (0.09, 0.12, 0.042)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Mesh "Rail" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </ROOT/Looks/Rail>
        int[] faceVertexCounts = [3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3]
        int[] faceVertexIndices = [0, 1, 5, 0, 5, 4, 1, 2, 6, 1, 6, 5, 2, 3, 7, 2, 7, 6, 3, 0, 4, 3, 4, 7, 3, 2, 1, 3, 1, 0, 4, 5, 6, 4, 6, 7]
        point3f[] points = [(-0.007, -0.03, 0), (0.007, -0.03, 0), (0.0115, -0.03, 0.006), (-0.0115, -0.03, 0.006), (-0.007, 0.036, 0), (0.007, 0.036, 0), (0.0115, 0.036, 0.006), (-0.0115, 0.036, 0.006)]
        uniform token subdivisionScheme = "none"
    }
    def Cube "Stop" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </ROOT/Looks/Stop>
        double size = 1
        double3 xformOp:translate = (0, 0.04, 0.008)
        float3 xformOp:scale = (0.05, 0.008, 0.016)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Scope "Colliders"
    {
        def Cube "Plate" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </ROOT/Looks/Phys_Metal> (
                bindMaterialAs = "weakerThanDescendants"
            )
            custom float physxCollision:contactOffset = 0.002
            custom float physxCollision:restOffset = 0
            uniform token purpose = "guide"
            double size = 1
        double3 xformOp:translate = (0, -0.0215, -0.004)
        float3 xformOp:scale = (0.11, 0.147, 0.008)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "Head" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </ROOT/Looks/Phys_Metal> (
                bindMaterialAs = "weakerThanDescendants"
            )
            custom float physxCollision:contactOffset = 0.002
            custom float physxCollision:restOffset = 0
            uniform token purpose = "guide"
            double size = 1
        double3 xformOp:translate = (0, -0.01, -0.029)
        float3 xformOp:scale = (0.09, 0.12, 0.042)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Mesh "Rail_col" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </ROOT/Looks/Phys_Metal> (
                bindMaterialAs = "weakerThanDescendants"
            )
            uniform token physics:approximation = "convexHull"
            custom float physxCollision:contactOffset = 0.002
            custom float physxCollision:restOffset = 0
            uniform token purpose = "guide"
            int[] faceVertexCounts = [3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3]
            int[] faceVertexIndices = [0, 1, 5, 0, 5, 4, 1, 2, 6, 1, 6, 5, 2, 3, 7, 2, 7, 6, 3, 0, 4, 3, 4, 7, 3, 2, 1, 3, 1, 0, 4, 5, 6, 4, 6, 7]
            point3f[] points = [(-0.007, -0.03, 0), (0.007, -0.03, 0), (0.0115, -0.03, 0.006), (-0.0115, -0.03, 0.006), (-0.007, 0.036, 0), (0.007, 0.036, 0), (0.0115, 0.036, 0.006), (-0.0115, 0.036, 0.006)]
            uniform token subdivisionScheme = "none"
        }
        def Cube "Stop" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </ROOT/Looks/Phys_Metal> (
                bindMaterialAs = "weakerThanDescendants"
            )
            custom float physxCollision:contactOffset = 0.002
            custom float physxCollision:restOffset = 0
            uniform token purpose = "guide"
            double size = 1
        double3 xformOp:translate = (0, 0.04, 0.008)
        float3 xformOp:scale = (0.05, 0.008, 0.016)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }
}
