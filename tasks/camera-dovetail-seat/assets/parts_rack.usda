#usda 1.0
(
    defaultPrim = "ROOT"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "ROOT" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    doc = "A parts rack: a 70 x 70 mm block 30 mm tall that the camera module lies on, a white square marked on top. Fixed to the table. Origin: the middle of its top face."
)
{
    bool physics:kinematicEnabled = true
    float physics:mass = 2.0

    def Scope "Looks"
    {
        def Material "Block"
        {
            token outputs:surface.connect = </ROOT/Looks/Block/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.35, 0.38, 0.42)
                float inputs:metallic = 0
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }
        def Material "Top"
        {
            token outputs:surface.connect = </ROOT/Looks/Top/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.85, 0.85, 0.85)
                float inputs:metallic = 0
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }
        def Material "Phys_Block" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.35
            float physics:restitution = 0
            float physics:staticFriction = 0.45
        }
    }

    def Cube "Block" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </ROOT/Looks/Block>
        double size = 1
        double3 xformOp:translate = (0, 0, -0.015)
        float3 xformOp:scale = (0.07, 0.07, 0.03)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cube "TopMark" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </ROOT/Looks/Top>
        double size = 1
        double3 xformOp:translate = (0, 0, 0.0003)
        float3 xformOp:scale = (0.06, 0.06, 0.0006)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Scope "Colliders"
    {
        def Cube "Block" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </ROOT/Looks/Phys_Block> (
                bindMaterialAs = "weakerThanDescendants"
            )
            custom float physxCollision:contactOffset = 0.002
            custom float physxCollision:restOffset = 0
            uniform token purpose = "guide"
            double size = 1
        double3 xformOp:translate = (0, 0, -0.015)
        float3 xformOp:scale = (0.07, 0.07, 0.03)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }
}
