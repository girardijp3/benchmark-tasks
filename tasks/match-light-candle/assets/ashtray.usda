        {
            float physics:dynamicFriction = 0.4
            float physics:restitution = 0
            float physics:staticFriction = 0.45
        }

        def Material "m929288_1_0_n_10"
        {
            token outputs:surface.connect = </Ashtray/Looks/m929288_1_0_n_10/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.93, 0.93, 0.89)
                float inputs:metallic = 0
                float inputs:roughness = 0.18
                token outputs:surface
            }
        }

        def Material "m112454_2_0_n_10"
