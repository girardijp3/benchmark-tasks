#usda 1.0
(
    defaultPrim = "Holder"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Holder" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    doc = "A low brass chamberstick: 91 mm drip dish, socket 22.8 mm across and 25 mm deep (3 mm 45 degree lead-in) with its rim 30 mm up, 0.35 kg, free on the table. Origin: table level, the socket's axis."
)
{
    point3f physics:centerOfMass = (0, 0, 0.011)
    float3 physics:diagonalInertia = (0.00012, 0.00012, 0.00016)
    float physics:mass = 0.35

    def Scope "Looks"
    {
        def Material "Phys_brass" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.3
            float physics:restitution = 0
            float physics:staticFriction = 0.35
        }

        def Material "m816325_3_9_n_10"
        {
            token outputs:surface.connect = </Holder/Looks/m816325_3_9_n_10/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.82, 0.64, 0.26)
                float inputs:metallic = 0.9
                float inputs:roughness = 0.32
                token outputs:surface
            }
        }

        def Material "m856727_3_9_n_10"
        {
            token outputs:surface.connect = </Holder/Looks/m856727_3_9_n_10/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.86, 0.68, 0.28)
                float inputs:metallic = 0.9
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }
    }

    def Cylinder "Dish1" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.005
        rel material:binding:physics = </Holder/Looks/Phys_brass> (
            bindMaterialAs = "weakerThanDescendants"
        )
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        uniform token purpose = "guide"
        double radius = 0.0455
        double3 xformOp:translate = (0, 0, 0.0025)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

