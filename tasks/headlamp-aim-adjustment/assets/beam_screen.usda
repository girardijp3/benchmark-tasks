#usda 1.0
(
    defaultPrim = "BeamScreen"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "BeamScreen" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    doc = "A 1.600 x 1.200 m matte white beam-aiming screen on two legs, its face 3.000 m from the H4 lamp lens. The red horizontal line is the ECE 1.2 % target 36 mm below the lamp centre (0.914 m); the two green lines are the +-15 mm vertical limit; the blue vertical line is the lamp centreline. The screen is fixed to the floor; its face is the x=0 plane of local coordinates (the task spawns it at x=3.620)."
)
{
    point3f physics:centerOfMass = (0, 0, 0)
    float3 physics:diagonalInertia = (0.6, 0.6, 1)
    float physics:mass = 8

    def Scope "Looks"
    {
        def Material "Phys_screen" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.5
            float physics:restitution = 0
            float physics:staticFriction = 0.6
        }

        def Material "screen_dbddd6_55_100"
        {
            token outputs:surface.connect = </BeamScreen/Looks/screen_dbddd6_55_100/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.86, 0.87, 0.84)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "c_0f0f10_55_100"
        {
            token outputs:surface.connect = </BeamScreen/Looks/c_0f0f10_55_100/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.06, 0.06, 0.065)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "Phys_stand" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.6
            float physics:restitution = 0
            float physics:staticFriction = 0.7
        }

        def Material "stand_0f0f10_55_100"
        {
            token outputs:surface.connect = </BeamScreen/Looks/stand_0f0f10_55_100/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.06, 0.06, 0.065)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "Phys_rubber" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.8
            float physics:restitution = 0
            float physics:staticFriction = 0.9
        }

        def Material "rubber_1e1e21_55_100"
        {
