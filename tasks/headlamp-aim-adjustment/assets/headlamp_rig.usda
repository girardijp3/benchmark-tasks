#usda 1.0
(
    defaultPrim = "HeadlampRig"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "HeadlampRig" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsArticulationRootAPI"]
    doc = "A Hella 1058 / 1L6 002 395-131 178 mm H4 headlamp (88 mm deep, 0.55 kg) in a bench gimbal on a cast stand at 0.950 m. The fixed stand is the articulation root; the lamp has a vertical yaw joint and a horizontal pitch joint on the gimbal (AimYaw, AimPitch). Two 8 mm hex-socket aim screws stand on the stand at 90 mm centres; each has a visible head (ScrewHeadV/H) and a coaxial shaft (ScrewV/H) coupled through a 0.9 N m torque fuse. Turning a head drives its shaft and the lamp's aim drive. Origin: world; table top 0.7475 m."
)
