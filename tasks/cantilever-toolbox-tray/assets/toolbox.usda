#usda 1.0
(
    defaultPrim = "Toolbox"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Toolbox" (
    delete apiSchemas = ["PhysicsMassAPI", "PhysicsRigidBodyAPI"]
    doc = "STANLEY 1-94-738 18 in. metal cantilever tool box: 460 x 208 x 208 mm, 4.8 kg, five trays, two metal latches, two carry handles.  Free articulation root Base on four rubber feet; ArmL/ArmR on revolute joints at the base side rims, WingL/WingR level trays on the arm tips, Top the lid on a vertical prismatic joint, LatchL/LatchR draw latches on the front corner posts.  Origin: middle of the base's underside on the bench."
)
{
    point3f physics:centerOfMass = (0, 0, 0.048)
    float3 physics:diagonalInertia = (0.059366666, 0.014477067, 0.067963734)
    float physics:mass = 3.2

    def Scope "Looks"
    {
        def Material "Phys_rubber" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.9
            float physics:restitution = 0
            float physics:staticFriction = 0.95
        }

        def Material "rubber"
        {
            token outputs:surface.connect = </Toolbox/Looks/rubber/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.02, 0.02, 0.02)
                float inputs:metallic = 0
                float inputs:roughness = 0.95
                token outputs:surface
            }
        }

        def Material "Phys_base" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.45
            float physics:restitution = 0
