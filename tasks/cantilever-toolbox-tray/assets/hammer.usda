#usda 1.0
(
    defaultPrim = "Hammer"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Hammer" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    doc = "A 300 mm claw hammer: 220 mm hickory handle, 90 mm steel head.  Rests in the toolbox's upper fixed tray.  Origin: the centre of the handle."
)
{
    point3f physics:centerOfMass = (0, 0.04, 0)
    float3 physics:diagonalInertia = (0.0037875, 0.000375, 0.0040875)
    float physics:mass = 0.5

    def Scope "Looks"
    {
        def Material "Phys_wood" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.45
            float physics:restitution = 0
            float physics:staticFriction = 0.55
        }

        def Material "m442509"
        {
            token outputs:surface.connect = </Hammer/Looks/m442509/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.45, 0.26, 0.1)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "Phys_steel" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.45
            float physics:restitution = 0
            float physics:staticFriction = 0.55
        }

        def Material "steel"
        {
            token outputs:surface.connect = </Hammer/Looks/steel/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.35, 0.36, 0.37)
                float inputs:metallic = 0.8
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "m343536"
        {
            token outputs:surface.connect = </Hammer/Looks/m343536/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.35, 0.36, 0.37)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "m040405"
        {
            token outputs:surface.connect = </Hammer/Looks/m040405/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.05, 0.05, 0.055)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }
    }

    def Cylinder "Handle1" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        uniform token axis = "Y"
        double height = 0.22
        rel material:binding = </Hammer/Looks/m442509>
        rel material:binding:physics = </Hammer/Looks/Phys_wood> (
            bindMaterialAs = "weakerThanDescendants"
        )
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        double radius = 0.007
        double3 xformOp:translate = (0, -0.005, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cube "Head2" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </Hammer/Looks/steel>
        rel material:binding:physics = </Hammer/Looks/Phys_steel> (
            bindMaterialAs = "weakerThanDescendants"
        )
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.03, 0.09, 0.022)
        double3 xformOp:translate = (0, 0.105, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Claw3" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Hammer/Looks/m343536>
        double size = 1
        float3 xformOp:scale = (0.026, 0.03, 0.012)
        double3 xformOp:translate = (0, 0.145, -0.006)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cylinder "Grip4" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "Y"
        double height = 0.01
        rel material:binding = </Hammer/Looks/m040405>
        double radius = 0.008
        double3 xformOp:translate = (0, -0.11, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}

