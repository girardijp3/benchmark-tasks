#usda 1.0
(
    defaultPrim = "WindowFrame"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "WindowFrame" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    doc = "A shed or greenhouse sliding window frame in a 40 mm sill: opening 480 x 270 mm, a 22 mm sash lane (front) and a fixed pane (back), lane walls 6 mm thick, a header, two jambs; the left jamb (+y) is the sash's end stop. Fixed. Origin: table level, the opening's middle in y, the front lane's middle in x."
)
{
    point3f physics:centerOfMass = (0, 0, 0.1)
    float3 physics:diagonalInertia = (0.05, 0.05, 0.05)
    float physics:mass = 5

    def Scope "Looks"
    {
        def Material "Phys_wood" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.4
            float physics:restitution = 0
            float physics:staticFriction = 0.4
        }

        def Material "m776139"
        {
            token outputs:surface.connect = </WindowFrame/Looks/m776139/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.78, 0.62, 0.4)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "m698489"
        {
            token outputs:surface.connect = </WindowFrame/Looks/m698489/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.7, 0.85, 0.9)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }
    }

    def Cube "Sill1" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </WindowFrame/Looks/m776139>
        rel material:binding:physics = </WindowFrame/Looks/Phys_wood> (
            bindMaterialAs = "weakerThanDescendants"
        )
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.09, 0.58, 0.04)
        double3 xformOp:translate = (0, 0, 0.02)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Lip2" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </WindowFrame/Looks/m776139>
        rel material:binding:physics = </WindowFrame/Looks/Phys_wood> (
            bindMaterialAs = "weakerThanDescendants"
        )
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.006, 0.48, 0.012)
        double3 xformOp:translate = (-0.013999999999999999, 0, 0.046)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "HeadWall3" (
