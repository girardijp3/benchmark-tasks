#usda 1.0
(
    defaultPrim = "PaperOffcut"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "PaperOffcut" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    doc = "The 100 mm offcut of an 80 gsm A4 sheet: 210 x 100 mm, 0.10 mm, 1.68 g.  The cut edge is the sheet's +Y edge (local y=+0.050); the other half of the red printed line lies along it."
)
{
    point3f physics:centerOfMass = (0, 0, 0)
    float3 physics:diagonalInertia = (5.5e-7, 1.8e-7, 7e-7)
    float physics:mass = 1.68

    def Scope "Looks"
    {
        def Material "Phys_c" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.38
            float physics:restitution = 0
            float physics:staticFriction = 0.42
        }

        def Material "c_f2f2ea_90_100"
        {
            token outputs:surface.connect = </PaperOffcut/Looks/c_f2f2ea_90_100/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.95, 0.92)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }

        def Material "c_b70f0c_55_100"
        {
            token outputs:surface.connect = </PaperOffcut/Looks/c_b70f0c_55_100/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.72, 0.06, 0.05)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "c_d1d1c6_55_100"
        {
            token outputs:surface.connect = </PaperOffcut/Looks/c_d1d1c6_55_100/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.82, 0.82, 0.78)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }
    }

    def Cube "Sheet1" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </PaperOffcut/Looks/c_f2f2ea_90_100>
        rel material:binding:physics = </PaperOffcut/Looks/Phys_c> (
            bindMaterialAs = "weakerThanDescendants"
        )
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.21, 0.1, 0.0001)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "CutLine2" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </PaperOffcut/Looks/c_b70f0c_55_100>
        double size = 1
        float3 xformOp:scale = (0.206, 0.0015, 0.00002)
        double3 xformOp:translate = (0, 0.04925, 0.00006)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Corner3" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </PaperOffcut/Looks/c_d1d1c6_55_100>
        double size = 1
        float3 xformOp:scale = (0.005, 0.005, 0.00001)
        double3 xformOp:translate = (-0.10099999999999999, -0.046, 0.000055)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Corner4" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </PaperOffcut/Looks/c_d1d1c6_55_100>
        double size = 1
        float3 xformOp:scale = (0.005, 0.005, 0.00001)
        double3 xformOp:translate = (0.10099999999999999, -0.046, 0.000055)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}

