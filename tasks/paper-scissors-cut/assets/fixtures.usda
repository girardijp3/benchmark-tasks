#usda 1.0
(
    defaultPrim = "Fixtures"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Fixtures" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    doc = "The paper station: a 20 mm wooden riser with a 1 mm green cutting mat (top 0.7685), a shallow grey letter tray beside it (rim 0.7600, floor 0.7495) that catches the 100 mm offcut, and a 1 mm grey rest mat for the scissors (top 0.7485).  All fixed to the table; origin at the world origin."
)
{
    point3f physics:centerOfMass = (0.45, -0.1, 0.77)
    float3 physics:diagonalInertia = (0.05, 0.05, 0.05)
    float physics:mass = 4

    def Scope "Looks"
    {
        def Material "Phys_wood" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.6
            float physics:restitution = 0
            float physics:staticFriction = 0.7
        }

        def Material "wood_845b33_55_100"
        {
            token outputs:surface.connect = </Fixtures/Looks/wood_845b33_55_100/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.52, 0.36, 0.2)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "Phys_mat" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.7
            float physics:restitution = 0
            float physics:staticFriction = 0.8
        }

